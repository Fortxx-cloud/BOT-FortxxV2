async def get_weather(city):
    """Open-Meteo: Cuaca real-time."""
    try:
        async with aiohttp.ClientSession() as session:
            geo_url = "https://geocoding-api.open-meteo.com/v1/search"
            async with session.get(geo_url, params={"name": city, "count": 1, "language": "id"}, timeout=10) as r:
                if r.status != 200: return "❌ Gagal cari lokasi."
                geo = await r.json()
                if not geo.get("results"): return f"❌ Kota '{city}' gak ditemukan."
                loc = geo["results"][0]
                
            weather_url = "https://api.open-meteo.com/v1/forecast"
            params = {
                "latitude": loc["latitude"], "longitude": loc["longitude"],
                "current": "temperature_2m,relative_humidity_2m,wind_speed_10m,weather_code",
                "timezone": "Asia/Jakarta"
            }
            async with session.get(weather_url, params=params, timeout=10) as r:
                if r.status != 200: return "❌ Gagal ambil cuaca."
                w = await r.json()
                cur = w["current"]
                return (
                    f"🌤️ **Cuaca {loc['name']}, {loc.get('country','')}**" + chr(10) +
                    f"🌡️ Suhu: {cur['temperature_2m']}°C" + chr(10) +
                    f"💧 Kelembapan: {cur['relative_humidity_2m']}%" + chr(10) +
                    f"💨 Angin: {cur['wind_speed_10m']} km/h"
                )
    except Exception as e:
        return f"❌ Error cuaca: {e}"

async def get_dictionary(word):
    """Free Dictionary API."""
    try:
        async with aiohttp.ClientSession() as session:
            url = f"https://api.dictionaryapi.dev/api/v2/entries/en/{word}"
            async with session.get(url, timeout=10) as r:
                if r.status != 200: return f"❌ Kata '{word}' gak ditemukan."
                data = await r.json()
                entry = data[0]
                mean = entry["meanings"][0]
                defn = mean["definitions"][0]["definition"]
                return (
                    f"📖 **{entry['word']}** ({mean['partOfSpeech']})" + chr(10) +
                    f"📝 {defn}"
                )
    except Exception as e:
        return f"❌ Error kamus: {e}"



_last_gdelt_call = 0.0

async def get_news(query="teknologi"):
    """FreeNewsAPI (keyless) -> GDELT (keyless, throttled)."""
    global _last_gdelt_call
    nl = chr(10)
    
    # 1. COBA FREENEWSAPI.AI (KEYLESS, NO QUOTA)
    try:
        async with aiohttp.ClientSession() as session:
            url = "https://freenewsapi.ai/v1/search"
            params = {"q": query, "size": 5}
            async with session.get(url, params=params, timeout=15) as r:
                if r.status == 200:
                    data = await r.json()
                    articles = data.get("articles", data if isinstance(data, list) else [])
                    if articles:
                        txt = "📰 **Berita Terkini (FreeNewsAPI):**" + nl
                        for i, art in enumerate(articles, 1):
                            title = art.get("title", "No Title")
                            link = art.get("url", art.get("link", ""))
                            src = art.get("source", art.get("publisher", ""))
                            txt += f"{i}. [{title}]({link})" + nl
                            if src:
                                txt += f"   📍 {src}" + nl
                        return txt
                elif r.status in [429, 402, 403]:
                    print("⚠️ [NEWS] FreeNewsAPI limit. Pindah ke GDELT...")
    except Exception as e:
        print(f"⚠️ [NEWS] FreeNewsAPI Error: {e}")

    # 2. FALLBACK KE GDELT (THROTTLE 5 DETIK)
    import time
    now = time.time()
    if now - _last_gdelt_call < 5:
        return "⏳ Tunggu 5 detik ya Bang, biar GDELT gak ngamuk."
    
    try:
        async with aiohttp.ClientSession() as session:
            url = "https://api.gdeltproject.org/api/v2/doc/doc"
            params = {"query": query, "mode": "ArtList", "maxrecords": 5, "format": "json", "sort": "DateDesc"}
            async with session.get(url, params=params, timeout=20) as r:
                _last_gdelt_call = time.time()
                if r.status == 200:
                    data = await r.json()
                    articles = data.get("articles", [])
                    if articles:
                        txt = "📰 **Berita (GDELT):**" + nl
                        for i, art in enumerate(articles, 1):
                            title = art.get("title", "No Title")
                            link = art.get("url", "")
                            txt += f"{i}. [{title}]({link})" + nl
                        return txt
                elif r.status == 429:
                    return "⏳ GDELT lagi limit. Coba lagi 5 detik lagi ya Bang."
    except Exception as e:
        return f"❌ Error GDELT: {e}"

    return "ℹ️ Gak ada berita yang ketemu."

    # Fallback: kalau GDELT limit, pakai search_multi
    try:
        results = await search_multi(f"berita {query}", limit=5)
        if results:
            lines = [f"📰 **Berita {query}** (sumber alternatif):\n"]
            for i, r in enumerate(results[:5], 1):
                if isinstance(r, dict):
                    title = str(r.get("title") or "?")[:100]
                    url = str(r.get("url") or r.get("link") or "")
                    lines.append(f"{i}. **{title}**\n   {url}")
            return "\n".join(lines)
    except Exception:
        pass
    return f"⏳ GDELT lagi limit & search alternatif gagal. Coba lagi bentar ya Bang."

async def get_currency(from_cur, to_cur):
    """Frankfurter: Kurs mata uang."""
    try:
        async with aiohttp.ClientSession() as session:
            url = f"https://api.frankfurter.app/latest?from={from_cur.upper()}&to={to_cur.upper()}"
            async with session.get(url, timeout=10) as r:
                if r.status != 200: return f"❌ Kurs {from_cur} ke {to_cur} gagal."
                data = await r.json()
                rate = data["rates"].get(to_cur.upper())
                return (
                    f"💱 **Kurs {from_cur.upper()} → {to_cur.upper()}**" + chr(10) +
                    f"1 {from_cur.upper()} = **{rate} {to_cur.upper()}**" + chr(10) +
                    f"📅 Update: {data['date']}"
                )
    except Exception as e:
        return f"❌ Error kurs: {e}"

async def get_ip_info(ip):
    """ip-api: Geolokasi IP."""
    try:
        async with aiohttp.ClientSession() as session:
            url = f"http://ip-api.com/json/{ip}?fields=status,country,city,isp,query"
            async with session.get(url, timeout=10) as r:
                if r.status != 200: return "❌ Gagal ambil IP info."
                data = await r.json()
                if data.get("status") != "success": return "❌ IP gak valid."
                return (
                    f"🌍 **Info IP: {data['query']}**" + chr(10) +
                    f"🏳️ Negara: {data['country']}" + chr(10) +
                    f"🏙️ Kota: {data['city']}" + chr(10) +
                    f"📡 ISP: {data['isp']}"
                )
    except Exception as e:
        return f"❌ Error IP: {e}"
# ══════════════════════════════════════════════════════════════



# ══════════════════════════════════════════════════════════════
# 📄 WEB READER + SUMMARIZER (Scrape URL & Rangkum)
# ══════════════════════════════════════════════════════════════

async def scrape_url(url):
    """Ambil isi website pakai 3 lapis fallback."""
    nl = chr(10)
    
    # LAPIS 1: FIRECRAWL (KEYLESS)
    try:
        async with aiohttp.ClientSession() as session:
            headers = {"Content-Type": "application/json"}
            payload = {"url": url, "formats": ["markdown"]}
            async with session.post("https://api.firecrawl.dev/v1/scrape", headers=headers, json=payload, timeout=25) as r:
                if r.status == 200:
                    data = await r.json()
                    md = data.get("data", {}).get("markdown", "")
                    title = data.get("data", {}).get("metadata", {}).get("title", url)
                    if md and len(md) > 100:
                        return {"title": title, "content": md, "url": url, "source": "Firecrawl"}
                elif r.status in [429, 402, 403]:
                    print("⚠️ [SCRAPE] Firecrawl limit. Pindah ke Jina...")
    except Exception as e:
        print(f"⚠️ [SCRAPE] Firecrawl Error: {e}")

    # LAPIS 2: JINA READER (DENGAN API KEY)
    try:
        jina_key = os.getenv("JINA_API_KEY")
        if not jina_key:
            print("⚠️ [SCRAPE] JINA_API_KEY gak ada di .env, pake mode keyless (bakal kena limit).")
            
        async with aiohttp.ClientSession() as session:
            jina_url = "https://r.jina.ai/" + url
            headers = {"User-Agent": "Mozilla/5.0", "Accept": "text/plain"}
            if jina_key:
                headers["Authorization"] = "Bearer " + jina_key
                
            async with session.get(jina_url, headers=headers, timeout=30) as r:
                if r.status == 200:
                    text = await r.text()
                    if text and len(text) > 100:
                        title = url
                        for line in text.split(nl)[:5]:
                            if line.startswith("Title:"):
                                title = line.replace("Title:", "").strip()
                                break
                        return {"title": title, "content": text, "url": url, "source": "Jina Reader"}
                else:
                    print(f"⚠️ [SCRAPE] Jina Error: HTTP {r.status}")
                    if r.status == 429:
                        print("   -> Rate limit Jina tercapai. Coba pake API Key.")
    except Exception as e:
        print(f"⚠️ [SCRAPE] Jina Exception: {type(e).__name__}")

    # LAPIS 3: BEAUTIFULSOUP (PARSING MANUAL)
    try:
        from bs4 import BeautifulSoup
        async with aiohttp.ClientSession() as session:
            headers = {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"}
            async with session.get(url, headers=headers, timeout=20) as r:
                if r.status == 200:
                    html = await r.text()
                    soup = BeautifulSoup(html, "html.parser")
                    # Buang script, style, nav, footer
                    for tag in soup(["script", "style", "nav", "footer", "header", "aside"]):
                        tag.decompose()
                    title = soup.title.string.strip() if soup.title else url
                    # Ambil teks dari body
                    paragraphs = soup.find_all(["p", "h1", "h2", "h3", "li"])
                    content = nl.join(p.get_text().strip() for p in paragraphs if p.get_text().strip())
                    if content and len(content) > 100:
                        return {"title": title, "content": content[:8000], "url": url, "source": "BeautifulSoup"}
    except Exception as e:
        print(f"⚠️ [SCRAPE] BS4 Error: {e}")

    return None

async def summarize_url(url, channel_id=None):
    """Scrape URL lalu rangkum pakai AI."""
    data = await scrape_url(url)
    if not data:
        return "❌ Gagal buka website. Mungkin diproteksi Cloudflare atau butuh login."

    # Potong content biar gak over token (max 6000 karakter)
    content = data["content"][:6000]

    system = "Kamu adalah perangkum web profesional. Rangkum isi web dalam bahasa Indonesia, poin-poin penting, dan sertakan insight. Jangan ngarang di luar isi web."
    prompt = "URL: " + data["url"] + chr(10) + "Judul: " + data["title"] + chr(10) + chr(10) + "Isi Web:" + chr(10) + content

    summary = await execute_task("architect", prompt, system, channel_id=channel_id)

    result = (
        "📄 **Rangkuman Web**" + chr(10) +
        "━━━━━━━━━━━━━━━━━━━━" + chr(10) +
        "🌐 **Judul:** " + data["title"] + chr(10) +
        "🔗 **URL:** " + data["url"] + chr(10) +
        "📡 **Sumber Scrape:** " + data["source"] + chr(10) +
        "━━━━━━━━━━━━━━━━━━━━" + chr(10) + chr(10) +
        summary
    )
    return result
# ══════════════════════════════════════════════════════════════



# ══════════════════════════════════════════════════════════════
# 🔍 DEEP RESEARCH (Search -> Scrape -> Summarize)
# ══════════════════════════════════════════════════════════════

async def expand_query(query):
    """AI rewrite query biar lebih spesifik & efektif."""
    import datetime
    current_year = datetime.datetime.now().year
    system = f"Kamu adalah query optimizer Google. Ubah pertanyaan user jadi query pencarian yang SPESIFIK dan EFEKTIF. Tambahkan kata kunci penting (nama produk lengkap, toko, dll) dan tahun berjalan yaitu {current_year} jika relevan. Balas HANYA dengan query (tanpa penjelasan, tanpa tanda kutip). Maksimal 10 kata."
    try:
        res = await execute_task("fast_chat", query, system)
        expanded = res.strip().strip('"').strip("'").split(chr(10))[0][:120]
        if expanded and len(expanded) > 3:
            print(f"🔍 [EXPAND] '{query}' -> '{expanded}'")
            return expanded
    except Exception as e:
        print(f"⚠️ [EXPAND] gagal: {e}")
    return query

async def search_multi(query, limit=10):
    """Search multi-engine. Prioritas: LangSearch -> Serper -> DDG -> Webless -> Tavily -> Exa."""
    all_results = []
    seen_urls = set()

    # 0. Expand query pakai AI
    expanded = await expand_query(query)

    # === LAPIS 1: LANGSEARCH (Paling longgar kuota + tercepat) ===
    lang_key = os.getenv("LANGSEARCH_API_KEY")
    if lang_key:
        try:
            async with aiohttp.ClientSession() as session:
                headers = {"Authorization": f"Bearer {lang_key}", "Content-Type": "application/json"}
                payload = {"query": expanded, "count": limit}
                async with session.post("https://api.langsearch.com/v1/web-search", headers=headers, json=payload, timeout=15) as r:
                    if r.status == 200:
                        data = await r.json()
                        pages = data.get("data", {}).get("webPages", {}).get("value", [])
                        for i in pages:
                            url = i.get("url")
                            if url and url not in seen_urls:
                                seen_urls.add(url)
                                all_results.append({
                                    "url": url,
                                    "title": i.get("name", ""),
                                    "snippet": str(i.get("snippet", ""))[:200],
                                    "source": "LangSearch"
                                })
                                if len(all_results) >= limit: break
                        print(f"✅ [SEARCH-1] LangSearch: {len(all_results)} hasil")
                    elif r.status in [429, 402, 403]:
                        print(f"⚠️ [SEARCH-1] LangSearch limit (HTTP {r.status}), pindah ke Serper...")
                    else:
                        print(f"⚠️ [SEARCH-1] LangSearch HTTP {r.status}")
        except Exception as e:
            print(f"⚠️ [SEARCH-1] LangSearch: {type(e).__name__}")

    # === LAPIS 2: SERPER (Google) ===
    if len(all_results) < limit:
        serper_key = os.getenv("SERPER_API_KEY")
        if serper_key:
            try:
                async with aiohttp.ClientSession() as session:
                    headers = {"X-API-KEY": serper_key, "Content-Type": "application/json"}
                    payload = {"q": expanded, "num": limit - len(all_results), "gl": "id", "hl": "id"}
                    async with session.post("https://google.serper.dev/search", headers=headers, json=payload, timeout=15) as r:
                        if r.status == 200:
                            data = await r.json()
                            added = 0
                            for i in data.get("organic", []):
                                url = i.get("link")
                                if url and url not in seen_urls:
                                    seen_urls.add(url)
                                    all_results.append({"url": url, "title": i.get("title", ""), "snippet": i.get("snippet", "")[:200], "source": "Google"})
                                    added += 1
                                    if len(all_results) >= limit: break
                            print(f"✅ [SEARCH-2] Serper/Google: +{added} hasil (total {len(all_results)})")
                        elif r.status in [429, 402, 403]:
                            print(f"⚠️ [SEARCH-2] Serper limit (HTTP {r.status}), pindah ke DDG...")
                        else:
                            print(f"⚠️ [SEARCH-2] Serper HTTP {r.status}")
            except Exception as e:
                print(f"⚠️ [SEARCH-2] Serper: {type(e).__name__}")

    # === LAPIS 3: DDG HTML ===
    if len(all_results) < limit:
        try:
            from bs4 import BeautifulSoup
            import urllib.parse
            async with aiohttp.ClientSession() as session:
                headers = {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"}
                async with session.get("https://html.duckduckgo.com/html/", params={"q": expanded}, headers=headers, timeout=15) as r:
                    if r.status == 200:
                        html = await r.text()
                        soup = BeautifulSoup(html, "html.parser")
                        added = 0
                        for a in soup.select("a.result__a"):
                            href = a.get("href", "")
                            if "uddg=" in href:
                                try: href = urllib.parse.unquote(href.split("uddg=")[1].split("&")[0])
                                except: pass
                            if href and href not in seen_urls:
                                seen_urls.add(href)
                                title = a.get_text().strip()
                                snippet = ""
                                parent = a.find_parent("div", class_="result")
                                if parent:
                                    sn = parent.find("a", class_="result__snippet")
                                    if sn: snippet = sn.get_text().strip()[:200]
                                all_results.append({"url": href, "title": title, "snippet": snippet, "source": "DDG"})
                                added += 1
                                if len(all_results) >= limit: break
                        print(f"✅ [SEARCH-3] DDG: +{added} hasil (total {len(all_results)})")
                    else:
                        print(f"⚠️ [SEARCH-3] DDG HTTP {r.status}")
        except Exception as e:
            print(f"⚠️ [SEARCH-3] DDG: {type(e).__name__}")

    # === LAPIS 4: WEBLESS ===
    if len(all_results) < 3:
        try:
            wl = await webless_search(expanded, limit=limit - len(all_results))
            added = 0
            for i in wl:
                url = str(getattr(i, 'url', ''))
                if url and url not in seen_urls:
                    seen_urls.add(url)
                    all_results.append({"url": url, "title": str(getattr(i, 'title', '')), "snippet": str(getattr(i, 'snippet', ''))[:200], "source": "Webless"})
                    added += 1
                    if len(all_results) >= limit: break
            print(f"✅ [SEARCH-4] Webless: +{added} hasil (total {len(all_results)})")
        except Exception as e:
            print(f"⚠️ [SEARCH-4] Webless: {type(e).__name__}")

    # === LAPIS 5: TAVILY ===
    if len(all_results) < limit:
        try:
            async with aiohttp.ClientSession() as session:
                headers = {"Content-Type": "application/json", "X-Tavily-Access-Mode": "keyless"}
                payload = {"query": expanded, "max_results": limit - len(all_results)}
                async with session.post("https://api.tavily.com/search", headers=headers, json=payload, timeout=15) as r:
                    if r.status == 200:
                        data = await r.json()
                        added = 0
                        for i in data.get("results", []):
                            url = i.get("url")
                            if url and url not in seen_urls:
                                seen_urls.add(url)
                                all_results.append({"url": url, "title": i.get("title", ""), "snippet": str(i.get("content", ""))[:200], "source": "Tavily"})
                                added += 1
                                if len(all_results) >= limit: break
                        print(f"✅ [SEARCH-5] Tavily: +{added} hasil (total {len(all_results)})")
        except Exception as e:
            print(f"⚠️ [SEARCH-5] Tavily: {type(e).__name__}")

    # === LAPIS 6: EXA ===
    if len(all_results) < 3:
        exa_key = os.getenv("EXA_API_KEY")
        if exa_key:
            try:
                async with aiohttp.ClientSession() as session:
                    headers = {"x-api-key": exa_key, "Content-Type": "application/json"}
                    payload = {"query": expanded, "numResults": limit - len(all_results)}
                    async with session.post("https://api.exa.ai/search", headers=headers, json=payload, timeout=15) as r:
                        if r.status == 200:
                            data = await r.json()
                            added = 0
                            for i in data.get("results", []):
                                url = i.get("url")
                                if url and url not in seen_urls:
                                    seen_urls.add(url)
                                    all_results.append({"url": url, "title": i.get("title", ""), "snippet": str(i.get("text", ""))[:200], "source": "Exa"})
                                    added += 1
                                    if len(all_results) >= limit: break
                            print(f"✅ [SEARCH-6] Exa: +{added} hasil (total {len(all_results)})")
            except Exception as e:
                print(f"⚠️ [SEARCH-6] Exa: {type(e).__name__}")

    return all_results

# Alias buat backward compat
async def search_raw(query, limit=3):
    return await search_multi(query, limit=limit)


async def get_live_rates():
    """Ambil kurs real-time untuk auto-convert ke IDR."""
    try:
        async with aiohttp.ClientSession() as session:
            url = "https://api.frankfurter.app/latest?from=USD&to=IDR,EUR,GBP,JPY,SGD,MYR,AUD"
            async with session.get(url, timeout=10) as r:
                if r.status == 200:
                    data = await r.json()
                    rates = data.get("rates", {})
                    rates["USD"] = 1.0
                    return rates
    except Exception as e:
        print(f"⚠️ [CURRENCY] Gagal ambil kurs: {e}")
    return {}

async def format_currency_rates():
    """Format kurs jadi teks rapi buat prompt AI."""
    rates = await get_live_rates()
    if not rates:
        return ""
    idr_per_usd = rates.get("IDR", 0)
    if idr_per_usd == 0:
        return ""
    lines = ["[KURS REAL-TIME HARI INI]"]
    lines.append(f"1 USD = {idr_per_usd:,.0f} IDR")
    for cur in ["EUR", "GBP", "JPY", "SGD", "MYR", "AUD"]:
        if cur in rates:
            idr_rate = rates[cur] * idr_per_usd
            lines.append(f"1 {cur} = {idr_rate:,.0f} IDR")
    return chr(10).join(lines)

async def research_web(query, channel_id=None, max_urls=3):
    """Deep Research Multi-Source: cari, scrape max 5 web paralel, rangkum semua."""
    nl = chr(10)

    print(f"🔍 [RESEARCH] Searching: {query}")
    results = await search_multi(query, limit=max_urls)

    if not results:
        return "❌ Gak nemu hasil pencarian buat: " + query

    urls_to_scrape = results[:max_urls]
    print(f"📄 [RESEARCH] Scraping {len(urls_to_scrape)} URL (sequential)...")

    # Sequential Scrape (1 per 1) biar gak kena rate limit
    scraped = []
    for r in urls_to_scrape:
        res = await scrape_url(r["url"])
        scraped.append(res)
        await asyncio.sleep(2) # Jeda 2 detik antar web

    ok = []
    for s in scraped:
        if s and not isinstance(s, Exception):
            ok.append(s)

    if not ok:
        snippets = nl.join(f"- {r['title']}: {r['snippet']}" for r in results)
        return "⚠️ Gagal buka semua web. Rangkuman dari snippet:" + nl + nl + snippets

    # Gabung konten (max 2000 char/sumber biar gak overload)
    combined = ""
    sources_list = ""
    for i, s in enumerate(ok, 1):
        content = s["content"][:2000]
        combined += nl + f"=== SUMBER {i}: {s['title']} ===" + nl
        combined += f"URL: {s['url']}" + nl
        combined += content + nl
        sources_list += f"{i}. [{s['title']}]({s['url']}) *(via {s['source']})*" + nl

    # Ambil kurs real-time buat convert otomatis
    currency_info = await format_currency_rates()

    system = (
        "Kamu adalah peneliti profesional. Jawab pertanyaan user berdasarkan SEMUA sumber web yang diberikan. "
        "Sintesis informasi dari berbagai sumber. Sebutkan fakta, angka, dan detail penting. "
        "Bahasa Indonesia, poin-poin jelas. Jangan ngarang di luar isi web. "
        "Kalau sumber tidak relevan dengan pertanyaan, bilang dengan jujur. "
        + ("PENTING: Jika ada harga/mata uang asing (EUR, USD, GBP, JPY, dll), WAJIB convert ke IDR pakai kurs berikut: " + chr(10) + currency_info + chr(10) + "Format: 'EUR 499 (~Rp 8.500.000)'." if currency_info else "")
    )
    prompt = f"Pertanyaan user: {query}{nl}{nl}Sumber-sumber web:{combined}"

    summary = await execute_task("architect", prompt, system, channel_id=channel_id)

    result = (
        "🔍 **Deep Research Multi-Source: " + query + "**" + nl +
        "━━━━━━━━━━━━━━━━━━━━" + nl +
        f"📚 **{len(ok)} Sumber Dibuka:**" + nl + sources_list +
        "━━━━━━━━━━━━━━━━━━━━" + nl + nl +
        summary
    )
    return result


async def decide_action(prompt):
    """Pakai AI buat mutusin aksi berdasarkan prompt user."""
    # === FAST PATH: skip LLM call untuk prompt simple ===
    p = prompt.strip().lower()
    import re as _re_fast
    # Fast-path 1: sapaan murni → instant chat (0ms)
    if _re_fast.match(r"^(halo|hai|hi|hallo|pagi|siang|sore|malam|test|tes|ping|p|woi|hey|bro|bang)[\s!?.,]*$", p):
        return {"action": "chat"}
    # Fast-path 2: pendek & nggak ada action verb → chat
    action_verbs = [
        "cari","search","google","buka","rangkum","http","https",
        "berita","harga","cuaca","jadwal","kapan","siapa","dimana",
        "arti","definisi","ip","bikin","buat","tambah","create",
        "hapus","delete","ubah","edit","set","kick","ban","mute",
        "unmute","kirim","send","post","channel","role","kategori","permission",
    ]
    if len(p) < 40 and not any(v in p for v in action_verbs):
        return {"action": "chat"}
    # === END FAST PATH ===
    system = """Kamu adalah Router AI. Tugasmu menentukan aksi berdasarkan prompt user.
    Balas HANYA dengan JSON valid, TANPA markdown, TANPA penjelasan.
    
    Aturan:
    - Jika user tanya info terbaru/berita/harga/jadwal/data terkini ATAU minta cari di internet, balas:
      {"action": "search", "query": "kata kunci pencarian spesifik"}
    - Jika user kasih URL dan minta dibuka/dirangkum/dijelaskan, balas:
      {"action": "scrape", "url": "https://..."}
    - Jika user tanya CUACA suatu kota, balas:
      {"action": "weather", "city": "nama kota"}
    - Jika user tanya ARTIKAN/ARTI kata atau DEFINISI istilah, balas:
      {"action": "dictionary", "word": "kata"}
    - Jika user minta BERITA/HEADLINE terbaru tentang topik tertentu, balas:
      {"action": "news", "query": "topik"}
    - Jika user tanya INFO IP address (misal "1.1.1.1 itu apa"), balas:
      {"action": "ip_info", "ip": "1.1.1.1"}
    - Jika user minta KELOLA server Discord (bikin/hapus/edit channel, role, kategori, permission), balas:
      {"action": "discord_action"}
    - Jika user minta LEBIH DARI 1 AKSI sekaligus (ada kata "terus/lalu/setelah itu/kemudian" yang nyambungin aksi, ATAU kombinasi info+Discord), balas:
      {"action": "multi_step"}
    - Jika user ngobrol biasa, nanya konsep umum, atau minta bikin sesuatu (NON-server), balas:
      {"action": "chat"}
    """
    try:
        # Router pakai model reasoning kuat (gpt-oss-120b)
        # Fallback ke fast_chat kalau gagal
        try:
            res = await execute_task("router", prompt, system)
        except:
            res = await execute_task("fast_chat", prompt, system)
        clean = res.replace("```json", "").replace("```", "").strip()
        start = clean.find("{")
        end = clean.rfind("}") + 1
        if start == -1 or end == 0: return {"action": "chat"}
        clean = clean[start:end]
        import json
        data = json.loads(clean)
        if data.get("action") not in ["search", "scrape", "weather", "dictionary", "news", "ip_info", "discord_action", "multi_step", "chat"]: return {"action": "chat"}
        return data
    except Exception as e:
        print(f"⚠️ [ROUTER] Fallback ke chat. Error: {e}")
        return {"action": "chat"}



