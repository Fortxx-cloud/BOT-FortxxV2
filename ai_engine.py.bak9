def build_tool_manifest():
    """Generate tool list untuk dipake LLM planner."""
    lines = []
    for name, meta in TOOL_REGISTRY.items():
        params = ", ".join(meta["params"].keys())
        lines.append(f"- {name}({params}): {meta['desc']}")
    return "\n".join(lines)

async def execute_tool(tool_name, guild, **kwargs):
    """Execute 1 tool dengan error handling. Return (success, result_str)."""
    meta = TOOL_REGISTRY.get(tool_name)
    if not meta:
        return False, f"❌ Tool '{tool_name}' nggak dikenal"
    if meta["needs_guild"] and guild is None:
        return False, f"❌ Tool '{tool_name}' butuh server context"
    try:
        result = await meta["fn"](guild, **kwargs)
        if result is None:
            return False, f"⚠️ Tool '{tool_name}' return kosong"
        return True, str(result)
    except Exception as e:
        return False, f"❌ {tool_name} error: {str(e)[:120]}"

# === 8. PLANNER (Fase 2 Batch 2) ===
def _resolve_prev(args, prev_result):
    """Substitusi $prev di args dengan hasil step sebelumnya (rekursif)."""
    if isinstance(args, dict):
        return {k: _resolve_prev(v, prev_result) for k, v in args.items()}
    if isinstance(args, list):
        return [_resolve_prev(v, prev_result) for v in args]
    if isinstance(args, str):
        if args == "$prev":
            return prev_result
        return args.replace("$prev", str(prev_result))
    return args

def _parse_plan(text):
    """Parse LLM output jadi list of steps atau None (chat)."""
    if not text: return None
    t = text.strip()
    # Strip markdown fence
    if t.startswith("```"):
        t = re.sub(r"^```[a-z]*\n?", "", t)
        t = re.sub(r"\n?```$", "", t)

    # Case 1: JSON array (task)
    start_arr = t.find("[")
    end_arr = t.rfind("]") + 1
    if start_arr != -1 and end_arr > 0:
        try:
            arr = json.loads(t[start_arr:end_arr])
            if isinstance(arr, list) and all(isinstance(s, dict) and "tool" in s for s in arr):
                return arr
        except json.JSONDecodeError:
            pass

    # Case 2: object {"action": "chat"} (bukan task)
    start_obj = t.find("{")
    end_obj = t.rfind("}") + 1
    if start_obj != -1 and end_obj > 0:
        try:
            obj = json.loads(t[start_obj:end_obj])
            if isinstance(obj, dict) and obj.get("action") == "chat":
                return None
            # Single object with tool = wrap jadi array
            if isinstance(obj, dict) and "tool" in obj:
                return [obj]
        except json.JSONDecodeError:
            pass

    return None

async def plan_task(user_prompt, has_guild=True):
    """LLM planner: pecah prompt jadi list tool calls. Return list atau None (chat)."""
    # Build manifest sesuai context
    if has_guild:
        manifest = build_tool_manifest()
    else:
        manifest = "\n".join([
            f"- {name}({', '.join(m['params'].keys())}): {m['desc']}"
            for name, m in TOOL_REGISTRY.items() if not m["needs_guild"]
        ])

    system = f"""Kamu adalah PLANNER agent Discord. Ubah permintaan user jadi JSON array step.
Balas HANYA JSON, tanpa markdown, tanpa penjelasan.

Tools tersedia:
{manifest}

Format output:
[
  {{"tool": "tool_name", "args": {{"param": "value"}}}},
  {{"tool": "tool_name", "args": {{"param": "$prev"}}}}
]

Arti "$prev": pakai hasil step sebelumnya sebagai nilai param.

ATURAN PENTING:
1. Kalau user cuma ngobrol / tanya konsep / minta jawaban teks → balas: {{"action": "chat"}}
2. Kalau cuma 1 aksi → tetap array dengan 1 item
3. Kalau multi-step → urutkan dengan dependencies benar
4. Kalau butuh hasil step sebelumnya (misal "cari X terus kirim ke Y") → pakai "$prev" di args
5. Kalau user minta "cari berita AI terbaru terus kirim ke #news":
   [{{"tool":"search_web","args":{{"query":"berita AI terbaru"}}}},{{"tool":"send_message","args":{{"channel":"news","text":"$prev"}}}}]
6. JANGAN pake tool server kalau user cuma tanya info (contoh: "cuaca jakarta" → langsung get_weather)
7. Kalau user minta bikin channel #X di kategori Y → create_channel dengan name dan category
8. Kalau ada kata "terus/lalu/setelah itu/dan" yang nyambungin aksi → multi-step
"""

    try:
        res = await execute_task("router", user_prompt, system)
        steps = _parse_plan(res)
        return steps
    except Exception as e:
        print(f"⚠️ [PLANNER] Error: {e}")
        return None

# === 9. EXECUTOR + AGENT ORCHESTRATOR (Fase 2 Batch 3) ===
async def execute_plan(steps, guild, channel_id=None):
    """Eksekusi list step berurutan dengan $prev substitution + smart abort."""
    if not steps:
        return None

    results = []
    prev_result = ""
    failed_at = None

    for i, step in enumerate(steps, 1):
        tool_name = step.get("tool", "")
        args = step.get("args", {}) or {}

        # Cek apakah step ini butuh $prev
        has_prev_dep = "$prev" in json.dumps(args)

        # Kalau ada step yang gagal & step ini butuh $prev → skip
        if failed_at is not None and has_prev_dep:
            results.append(f"{i}. ⏭️ **{tool_name}**: dilewati (butuh hasil step {failed_at} yang gagal)")
            continue

        # Resolve $prev
        resolved_args = _resolve_prev(args, prev_result)

        print(f"🔧 [EXEC {i}/{len(steps)}] {tool_name}({resolved_args})")
        ok, res = await execute_tool(tool_name, guild, **resolved_args)

        if ok:
            results.append(f"{i}. ✅ **{tool_name}**: {res[:300]}")
            prev_result = res
        else:
            results.append(f"{i}. {res}")
            if failed_at is None:
                failed_at = i
            prev_result = ""

    header = f"🤖 **Eksekusi {len(steps)} aksi:**\n\n"
    footer = ""
    if failed_at is not None:
        footer = f"\n\n⚠️ Step {failed_at} gagal. Step lain yang butuh hasilnya dilewati."
    return header + "\n".join(results) + footer

async def run_agent(user_prompt, guild=None, channel_id=None):
    """High-level: plan + execute. Return summary string atau None (chat)."""
    plan = await plan_task(user_prompt, has_guild=(guild is not None))
    if plan is None:
        return None
    if len(plan) == 0:
        return None
    return await execute_plan(plan, guild, channel_id=channel_id)
