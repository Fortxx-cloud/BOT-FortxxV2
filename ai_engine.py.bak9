COOLDOWNS = {}
COOLDOWN_DURATION = 600

# === 4. CORE API CALLER ===
async def _call_api(session, provider_name, model, messages, image_b64=None):
    cfg = PROVIDERS.get(provider_name)
    if not cfg: return None, "SKIP"

    headers = {"Content-Type": "application/json"}
    if cfg["key"]: headers["Authorization"] = f"Bearer {cfg['key']}"

    if image_b64:
        content = [{"type": "text", "text": messages[-1]["content"]}]
        content.append({"type": "image_url", "image_url": {"url": f"data:image/jpeg;base64,{image_b64}"}})
        messages[-1]["content"] = content

    if cfg["type"] == "gemini":
        url = cfg["url"].format(model=model, key=cfg["key"])
        payload = {"contents": [{"parts": [{"text": m["content"] if isinstance(m["content"], str) else m["content"][0]["text"]}]} for m in messages]}
        if image_b64: payload["contents"][-1]["parts"].append({"inline_data": {"mime_type": "image/jpeg", "data": image_b64}})
    elif cfg["type"] == "cloudflare":
        url = f"{cfg['url'].format(acc=cfg['acc'])}{model}"
        payload = {"messages": messages}
    elif cfg["type"] == "cohere":
        url = cfg["url"]
        payload = {"model": model, "messages": messages}
    else:
        url = cfg["url"]
        payload = {"model": model, "messages": messages, "max_tokens": 8000}

    try:
        async with session.post(url, headers=headers, json=payload, timeout=25) as r:
            if r.status == 200:
                data = await r.json()
                if cfg["type"] == "gemini":
                    txt = data['candidates'][0]['content']['parts'][0]['text']
                elif cfg["type"] == "cloudflare":
                    txt = data['result']['response']
                else:
                    txt = data['choices'][0]['message']['content']
                # Defensive: thinking model kadang return empty content
                if not txt or not txt.strip():
                    return None, "EMPTY"
                return txt, "OK"
            elif r.status in [429, 402, 403]: return None, "LIMIT"
            else: return None, "ERROR"
    except Exception: return None, "ERROR"

# === 5. EXECUTE TASK (DENGAN MEMORY) ===
async def execute_task(task_type, prompt, system_prompt="Kamu adalah asisten AI yang cerdas.", image_bytes=None, channel_id=None):
    messages = [{"role": "system", "content": system_prompt}]
    
    # Tarik ingatan dari database kalau ada channel_id
    if channel_id:
        history = get_chat_history(channel_id, 6)
        for user, role, content in history:
            messages.append({"role": role, "content": content})
            
    messages.append({"role": "user", "content": prompt})
    image_b64 = base64.b64encode(image_bytes).decode('utf-8') if image_bytes else None
    
    models_to_try = TASKS.get(task_type, []) + TASKS["emergency"]
    
    async with aiohttp.ClientSession() as session:
        for provider, model in models_to_try:
            model_key = (provider, model)
            if model_key in COOLDOWNS and time.time() < COOLDOWNS[model_key]:
                continue
                
            print(f"🚀 [ROUTER] Mencoba {provider} -> {model}...")
            res, status = await _call_api(session, provider, model, messages, image_b64)
            
            if status == "OK" and res:
                if channel_id:
                    save_chat(channel_id, "User", "user", prompt)
                    save_chat(channel_id, "Bot", "assistant", res)
                return res
            elif status == "LIMIT":
                COOLDOWNS[model_key] = time.time() + COOLDOWN_DURATION
                print(f"⚠️ [LIMIT] {provider} -> {model} penjara {COOLDOWN_DURATION}s!")
                
    return "❌ Maaf Bang, semua model AI sedang sibuk."

# === 6. MULTI-STEP AGENT (TOOL REGISTRY) ===

# Whitelist channel yang TIDAK boleh dihapus
PROTECTED_CHANNELS = {"general", "rules", "welcome", "announcements", "pengumuman", "info", "main"}
# Whitelist role yang TIDAK boleh dihapus
PROTECTED_ROLES = {"@everyone", "Admin", "Administrator", "Moderator", "Owner", "Bot"}

async def _tool_create_category(guild, name, **kw):
    if discord.utils.get(guild.categories, name=name):
        return f"⏭️ Category '{name}' udah ada"
    await guild.create_category(name)
    return f"✅ Category '{name}' dibuat"

async def _tool_create_channel(guild, name, category=None, type="text", **kw):
    if discord.utils.get(guild.text_channels, name=name) or discord.utils.get(guild.voice_channels, name=name):
        return f"⏭️ Channel '#{name}' udah ada"
    cat = discord.utils.get(guild.categories, name=category) if category else None
    if type == "voice":
        await guild.create_voice_channel(name, category=cat)
    else:
        await guild.create_text_channel(name, category=cat)
    return f"✅ Channel '#{name}' ({type}) dibuat" + (f" di '{category}'" if category else "")

async def _tool_delete_channel(guild, name, **kw):
    ch = discord.utils.get(guild.text_channels, name=name) or discord.utils.get(guild.voice_channels, name=name)
    if not ch:
        return f"❌ Channel '#{name}' nggak ada"
    if name.lower() in PROTECTED_CHANNELS:
        return f"🛡️ Channel '#{name}' dilindungi, nggak bisa dihapus via bot"
    await ch.delete()
    return f"✅ Channel '#{name}' dihapus"

async def _tool_edit_channel(guild, name, new_name=None, topic=None, slowmode=None, **kw):
    ch = discord.utils.get(guild.text_channels, name=name)
    if not ch:
        return f"❌ Channel '#{name}' nggak ada"
    edits = {}
    if new_name: edits["name"] = new_name
    if topic is not None: edits["topic"] = topic
    if slowmode is not None: edits["slowmode_delay"] = int(slowmode)
    if not edits: return f"⚠️ Nggak ada perubahan buat '#{name}'"
    await ch.edit(**edits)
    return f"✅ Channel '#{name}' diedit ({', '.join(edits.keys())})"

async def _tool_set_permission(guild, channel, role=None, allow=None, deny=None, **kw):
    ch = discord.utils.get(guild.text_channels, name=channel)
    if not ch:
        return f"❌ Channel '#{channel}' nggak ada"
    target = guild.default_role if role == "@everyone" else (discord.utils.get(guild.roles, name=role) if role else guild.default_role)
    if not target:
        return f"❌ Role '{role}' nggak ketemu"
    perms = discord.PermissionOverwrite()
    for p in (allow or []):
        if hasattr(perms, p): setattr(perms, p, True)
    for p in (deny or []):
        if hasattr(perms, p): setattr(perms, p, False)
    await ch.set_permissions(target, overwrite=perms)
    return f"✅ Permission #{channel} di-set (target: {role or '@everyone'})"

async def _tool_create_role(guild, name, color=None, **kw):
    if discord.utils.get(guild.roles, name=name):
        return f"⏭️ Role '{name}' udah ada"
    kwargs = {"name": name}
    if color:
        try: kwargs["colour"] = discord.Color(int(color.lstrip("#"), 16))
        except: pass
    await guild.create_role(**kwargs)
    return f"✅ Role '{name}' dibuat"

async def _tool_delete_role(guild, name, **kw):
    role = discord.utils.get(guild.roles, name=name)
    if not role:
        return f"❌ Role '{name}' nggak ada"
    if name in PROTECTED_ROLES:
        return f"🛡️ Role '{name}' dilindungi, nggak bisa dihapus"
    await role.delete()
    return f"✅ Role '{name}' dihapus"

async def _tool_assign_role(guild, member_name, role_name, **kw):
    member = discord.utils.get(guild.members, name=member_name) or discord.utils.get(guild.members, display_name=member_name)
    role = discord.utils.get(guild.roles, name=role_name)
    if not member: return f"❌ Member '{member_name}' nggak ketemu"
    if not role: return f"❌ Role '{role_name}' nggak ketemu"
    await member.add_roles(role)
    return f"✅ Role '{role_name}' di-assign ke {member.display_name}"

async def _tool_remove_role(guild, member_name, role_name, **kw):
    member = discord.utils.get(guild.members, name=member_name) or discord.utils.get(guild.members, display_name=member_name)
    role = discord.utils.get(guild.roles, name=role_name)
    if not member: return f"❌ Member '{member_name}' nggak ketemu"
    if not role: return f"❌ Role '{role_name}' nggak ketemu"
    await member.remove_roles(role)
    return f"✅ Role '{role_name}' dicopot dari {member.display_name}"

async def _tool_send_message(guild, channel, text, **kw):
    ch = discord.utils.get(guild.text_channels, name=channel)
    if not ch: return f"❌ Channel '#{channel}' nggak ada"
    await ch.send(text[:2000])
    return f"✅ Pesan terkirim ke #{channel}"

async def _tool_send_embed(guild, channel, title, description="", **kw):
    ch = discord.utils.get(guild.text_channels, name=channel)
    if not ch: return f"❌ Channel '#{channel}' nggak ada"
    emb = discord.Embed(title=title[:256], description=description[:4000], color=discord.Color.blurple())
    await ch.send(embed=emb)
    return f"✅ Embed terkirim ke #{channel}"

async def _tool_pin_message(guild, channel, **kw):
    ch = discord.utils.get(guild.text_channels, name=channel)
    if not ch: return f"❌ Channel '#{channel}' nggak ada"
    async for msg in ch.history(limit=5):
        await msg.pin()
        return f"✅ Pesan terakhir di #{channel} di-pin"
    return f"❌ Nggak ada pesan buat di-pin di #{channel}"

async def _tool_create_thread(guild, channel, name, **kw):
    ch = discord.utils.get(guild.text_channels, name=channel)
    if not ch: return f"❌ Channel '#{channel}' nggak ada"
    await ch.create_thread(name=name, type=discord.ChannelType.public_thread)
    return f"✅ Thread '{name}' dibuat di #{channel}"

TOOLS = {
    "create_category": _tool_create_category,
    "create_channel": _tool_create_channel,
    "delete_channel": _tool_delete_channel,
    "edit_channel": _tool_edit_channel,
    "set_permission": _tool_set_permission,
    "create_role": _tool_create_role,
    "delete_role": _tool_delete_role,
    "assign_role": _tool_assign_role,
    "remove_role": _tool_remove_role,
    "send_message": _tool_send_message,
    "send_embed": _tool_send_embed,
    "pin_message": _tool_pin_message,
    "create_thread": _tool_create_thread,
}

AGENT_SYSTEM = """Kamu adalah Agen Server Discord yang sangat patuh pada JSON schema.
Tugasmu: ubah permintaan user jadi JSON array aksi server.

OUTPUT HANYA JSON ARRAY, tanpa markdown, tanpa penjelasan.

Aksi yang tersedia (field sesuai contoh):
- create_category: {"action": "create_category", "name": "Nama"}
- create_channel: {"action": "create_channel", "name": "nama", "category": "Nama", "type": "text|voice"}
- delete_channel: {"action": "delete_channel", "name": "nama"}
- edit_channel: {"action": "edit_channel", "name": "lama", "new_name": "baru", "topic": "topik", "slowmode": 5}
- set_permission: {"action": "set_permission", "channel": "nama", "role": "RoleName|@everyone", "allow": ["view_channel"], "deny": ["send_messages"]}
- create_role: {"action": "create_role", "name": "Nama", "color": "#FF0000"}
- delete_role: {"action": "delete_role", "name": "Nama"}
- assign_role: {"action": "assign_role", "member_name": "username", "role_name": "Nama"}
- remove_role: {"action": "remove_role", "member_name": "username", "role_name": "Nama"}
- send_message: {"action": "send_message", "channel": "nama", "text": "isi"}
- send_embed: {"action": "send_embed", "channel": "nama", "title": "Judul", "description": "Isi"}
- pin_message: {"action": "pin_message", "channel": "nama"}
- create_thread: {"action": "create_thread", "channel": "nama", "name": "NamaThread"}

ATURAN PENTING:
- Kalau user minta "bikin channel X di kategori Y", pakai create_channel dengan category=Y
- Kalau user minta "set permission cuma X", pakai deny=["send_messages"] + allow=["view_channel"]
- Kalau user minta "hapus semua channel kecuali X", JANGAN — di luar scope, balas "CHAT: itu terlalu berbahaya"
- Kalau user NGGAK minta aksi server (cuma ngobrol), balas: "CHAT: [jawaban biasa]"
- Multiple actions: output array >1 item. Contoh: "bikin channel A dan B, terus hapus C" → [3 items]"""

def _parse_actions(text):
    """Extract JSON array dari response LLM (handle markdown fence)."""
    if not text: return None
    t = text.strip()
    # Strip markdown fence
    if t.startswith("```"):
        t = re.sub(r"^```[a-z]*\n?", "", t)
        t = re.sub(r"\n?```$", "", t)
    # Cari array
    start = t.find("[")
    end = t.rfind("]") + 1
    if start == -1 or end == 0: return None
    try:
        return json.loads(t[start:end])
    except json.JSONDecodeError:
        return None

async def agent_action(guild, user_prompt, channel_id=None):
    """Plan + execute multi-step Discord actions via LLM."""
    if guild is None:
        return None

    res = await execute_task("architect", user_prompt, AGENT_SYSTEM, channel_id=channel_id)

    # Kalau LLM bilang ini cuma chat, return None biar bot.py fallback
    if not res or res.strip().startswith("CHAT:"):
        return None

    actions = _parse_actions(res)
    if not actions:
        return f"⚠️ Planner gagal parse JSON. Response: {res[:200]}"

    results = []
    for i, act in enumerate(actions, 1):
        tool_name = act.get("action", "")
        fn = TOOLS.get(tool_name)
        if not fn:
            results.append(f"{i}. ⚠️ Tool '{tool_name}' nggak dikenal, skip")
            continue
        try:
            kwargs = {k: v for k, v in act.items() if k != "action"}
            r = await fn(guild, **kwargs)
            results.append(f"{i}. {r}")
        except Exception as e:
            results.append(f"{i}. ❌ {tool_name} gagal: {str(e)[:100]}")

    header = f"🤖 **Eksekusi {len(results)} aksi:**\n"
    return header + "\n".join(results)

# === 7. UNIFIED TOOL REGISTRY (Fase 2 — Hybrid Planner) ===
# Semua tool yang bisa dipanggil planner: Discord actions + info tools

# Wrapper untuk tools info (signature-nya beda, perlu adapter)
async def _wrap_weather(guild, city, **kw):
    return await get_weather(city)

async def _wrap_dictionary(guild, word, **kw):
    return await get_dictionary(word)

async def _wrap_news(guild, query="teknologi", **kw):
    return await get_news(query)

async def _wrap_currency(guild, from_cur="USD", to_cur="IDR", **kw):
    return await get_currency(from_cur, to_cur)

async def _wrap_ip_info(guild, ip, **kw):
    return await get_ip_info(ip)

async def _search_serper(query, limit=5):
    """Direct Serper — paling relevan buat query Indonesia (Google result)."""
    key = os.getenv("SERPER_API_KEY")
    if not key: return []
    try:
        async with aiohttp.ClientSession() as s:
            async with s.post(
                "https://google.serper.dev/search",
                headers={"X-API-KEY": key, "Content-Type": "application/json"},
                json={"q": query, "num": limit, "gl": "id", "hl": "id"},
                timeout=10,
            ) as r:
                if r.status != 200: return []
                data = await r.json()
                return [
                    {"title": o.get("title", ""), "url": o.get("link", ""), "snippet": o.get("snippet", "")}
                    for o in data.get("organic", [])
                ]
    except Exception:
        return []

async def _search_exa(query, limit=5):
    """Direct Exa — bagus buat English / semantic search."""
    key = os.getenv("EXA_API_KEY")
    if not key: return []
    try:
        async with aiohttp.ClientSession() as s:
            async with s.post(
                "https://api.exa.ai/search",
                headers={"x-api-key": key, "Content-Type": "application/json"},
                json={"query": query, "numResults": limit, "type": "keyword"},
                timeout=10,
            ) as r:
                if r.status != 200: return []
                data = await r.json()
                return [
                    {"title": x.get("title", ""), "url": x.get("url", ""),
                     "snippet": (x.get("text") or "")[:200]}
                    for x in data.get("results", [])
                ]
    except Exception:
        return []

async def _wrap_search(guild, query, **kw):
    """Quick search: Serper -> Exa -> search_multi fallback. NO scraping."""
    results = []

    # Tier 1: Serper (paling relevan buat ID)
    results = await _search_serper(query, limit=5)

    # Tier 2: Exa (English/semantic)
    if not results:
        results = await _search_exa(query, limit=5)

    # Tier 3: Fallback ke search_multi lama
    if not results:
        try:
            results = await search_multi(query, limit=5)
        except Exception as e:
            return f"❌ Search error: {str(e)[:100]}"
    if not results:
        return f"❌ Nggak nemu hasil buat: {query}"
    lines = [f"🔍 **Hasil pencarian: {query}**\n"]
    for i, r in enumerate(results[:5], 1):
        if isinstance(r, dict):
            title = str(r.get("title") or r.get("name") or "?")[:100]
            url = str(r.get("url") or r.get("link") or "")
            snippet = str(r.get("snippet") or r.get("description") or r.get("content") or "")[:200]
        else:
            title, url, snippet = str(r)[:100], "", ""
        lines.append(f"{i}. **{title}**\n   {url}\n   {snippet}\n")
    return "\n".join(lines)

async def _wrap_deep_research(guild, query, **kw):
    """Deep research: scrape URLs + synthesize (lambat tapi thorough)."""
    return await research_web(query)

async def _wrap_summarize(guild, url, **kw):
    return await summarize_url(url)

