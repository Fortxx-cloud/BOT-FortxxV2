# Sistem Penalty Box (Cooldown)
COOLDOWNS = {} # Menyimpan waktu kapan model boleh dipake lagi
COOLDOWN_DURATION = 300 # 5 menit (300 detik)

async def _call_api(session, provider_name, model, messages, image_b64=None):
    cfg = PROVIDERS.get(provider_name)
    if not cfg: return None, "SKIP"

    headers = {"Content-Type": "application/json"}
    if cfg["key"]: headers["Authorization"] = f"Bearer {cfg['key']}"

    # Format Payload
    if image_b64:
        content = [{"type": "text", "text": messages[-1]["content"]}]
        content.append({"type": "image_url", "image_url": {"url": f"data:image/jpeg;base64,{image_b64}"}})
        messages[-1]["content"] = content

    if cfg["type"] == "gemini":
        url = cfg["url"].format(model=model, key=cfg["key"])
        payload = {"contents": [{"parts": [{"text": m["content"] if isinstance(m["content"], str) else m["content"][0]["text"]}]} for m in messages]}
        if image_b64:
            payload["contents"][-1]["parts"].append({"inline_data": {"mime_type": "image/jpeg", "data": image_b64}})
    elif cfg["type"] == "cloudflare":
        url = f"{cfg['url'].format(acc=cfg['acc'])}{model}"
        payload = {"messages": messages}
    elif cfg["type"] == "cohere":
        url = cfg["url"]
        payload = {"model": model, "messages": messages}
    else:
        url = cfg["url"]
        payload = {"model": model, "messages": messages, "max_tokens": 1000}

    try:
        async with session.post(url, headers=headers, json=payload, timeout=10) as r:
            if r.status == 200:
                data = await r.json()
                if cfg["type"] == "gemini":
                    return data['candidates'][0]['content']['parts'][0]['text'], "OK"
                elif cfg["type"] == "cloudflare":
                    return data['result']['response'], "OK"
                else:
                    return data['choices'][0]['message']['content'], "OK"
            elif r.status in [429, 402, 403]:
                # Kena limit atau butuh duit
                return None, "LIMIT"
            else:
                return None, "ERROR"
    except Exception:
        return None, "ERROR"

async def execute_task(task_type, prompt, system_prompt="Kamu adalah asisten AI yang cerdas.", image_bytes=None):
    """Fokus 1 model, kalau limit masuk penalty box, baru ganti."""
    
    messages = [
        {"role": "system", "content": system_prompt},
        {"role": "user", "content": prompt}
    ]
    
    image_b64 = base64.b64encode(image_bytes).decode('utf-8') if image_bytes else None
    
    models_to_try = TASKS.get(task_type, [])
    models_to_try.extend(TASKS["emergency"])
    
    async with aiohttp.ClientSession() as session:
        for provider, model in models_to_try:
            model_key = (provider, model)
            
            # Cek apakah model ini lagi masuk "Penalty Box" (Cooldown)
            if model_key in COOLDOWNS and time.time() < COOLDOWNS[model_key]:
                sisa_waktu = int(COOLDOWNS[model_key] - time.time())
                print(f"⏩ [SKIP] {provider} -> {model} (Cooldown {sisa_waktu}s lagi)")
                continue # Skip model ini, langsung cek model berikutnya
                
            print(f"🚀 [ROUTER] Mencoba {provider} -> {model}...")
            res, status = await _call_api(session, provider, model, messages, image_b64)
            
            if status == "OK" and res:
                return res # Berhasil! Langsung balikin jawaban
            elif status == "LIMIT":
                # Masukin ke Penalty Box selama 5 menit
                COOLDOWNS[model_key] = time.time() + COOLDOWN_DURATION
                print(f"⚠️ [LIMIT] {provider} -> {model} kena limit. Masuk penjara {COOLDOWN_DURATION}s!")
            else:
                print(f"❌ [ERROR] {provider} -> {model} gagal. Coba cadangan...")
                
    return "❌ Maaf Bang, semua model AI sedang sibuk/limit. Coba lagi 5 menit lagi ya."
