import discord
from discord.ext import commands
import os
import json
import asyncio
from dotenv import load_dotenv
from ai_engine import execute_task
from keep_alive import keep_alive

load_dotenv()

# ══════════════════════════════════════════════════════════════
# 🧠 SMART CORE - Memory, Context, Natural Actions
# ══════════════════════════════════════════════════════════════
from collections import deque
import re as _re

_CHAT_MEMORY = {}

def _get_mem(ch_id):
    if ch_id not in _CHAT_MEMORY:
        _CHAT_MEMORY[ch_id] = deque(maxlen=10)
    return _CHAT_MEMORY[ch_id]

def _add_mem(ch_id, role, content):
    _get_mem(ch_id).append({"role": role, "content": content})

def _build_server_context(guild):
    cats = ", ".join(c.name for c in guild.categories) or "kosong"
    tch = ", ".join(c.name for c in guild.text_channels) or "kosong"
    vch = ", ".join(c.name for c in guild.voice_channels) or "kosong"
    rls = ", ".join(r.name for r in guild.roles if r.name != "@everyone") or "kosong"
    return (
        "[INFO SERVER ASLI]" + chr(10) +
        "Nama: " + guild.name + " | Member: " + str(guild.member_count) + chr(10) +
        "Kategori: " + cats + chr(10) +
        "Text Channel: " + tch + chr(10) +
        "Voice Channel: " + vch + chr(10) +
        "Role: " + rls
    )

async def smart_action(message, prompt):
    p = prompt.lower()
    guild = message.guild
    
    m = _re.search(r"(?:buat|bikin|tambah|create)\s+(?:channel|kanal|text)\s+[\"']?([a-z0-9\-_]+)", p)
    if m and not ("voice" in p or "suara" in p):
        name = m.group(1)
        try:
            ch = await guild.create_text_channel(name)
            return "✅ Channel " + ch.mention + " berhasil dibuat!"
        except Exception as e:
            return "❌ Gagal buat channel: " + str(e)
    
    m = _re.search(r"(?:buat|bikin|tambah|create)\s+(?:voice|suara)\s+[\"']?([a-z0-9\-_]+)", p)
    if m:
        name = m.group(1)
        try:
            ch = await guild.create_voice_channel(name)
            return "✅ Voice " + ch.mention + " berhasil dibuat!"
        except Exception as e:
            return "❌ Gagal: " + str(e)
    
    m = _re.search(r"(?:buat|bikin|tambah|create)\s+(?:role|peran)\s+[\"']?([a-z0-9\-_ ]+)", p)
    if m:
        name = m.group(1).strip()
        try:
            r = await guild.create_role(name=name)
            return "✅ Role " + r.mention + " berhasil dibuat!"
        except Exception as e:
            return "❌ Gagal: " + str(e)
    
    m = _re.search(r"(?:hapus|delete|remove)\s+(?:channel|kanal)\s+[\"']?([a-z0-9\-_]+)", p)
    if m:
        name = m.group(1)
        ch = discord.utils.get(guild.text_channels, name=name)
        if ch:
            try:
                await ch.delete()
                return "✅ Channel #" + name + " dihapus."
            except Exception as e:
                return "❌ Gagal: " + str(e)
        return "❌ Channel #" + name + " gak ketemu."
    
    m = _re.search(r"(?:hapus|delete|remove)\s+(?:role|peran)\s+[\"']?([a-z0-9\-_ ]+)", p)
    if m:
        name = m.group(1).strip()
        r = discord.utils.get(guild.roles, name=name)
        if r:
            try:
                await r.delete()
                return "✅ Role " + name + " dihapus."
            except Exception as e:
                return "❌ Gagal: " + str(e)
        return "❌ Role " + name + " gak ketemu."
    
    return None

async def smart_chat(message, prompt):
    ch_id = message.channel.id
    guild = message.guild
    
    server_ctx = _build_server_context(guild)
    history = list(_get_mem(ch_id))
    _add_mem(ch_id, "user", prompt)
    
    full_prompt = server_ctx + chr(10) + chr(10) + "[RIWAYAT CHAT TERAKHIR]" + chr(10)
    for h in history[-6:]:
        full_prompt += h["role"] + ": " + h["content"][:200] + chr(10)
    full_prompt += chr(10) + "User bertanya: " + prompt
    
    system = (
        "Kamu adalah asisten AI super pinter buat server Discord. "
        "Jawab berdasarkan DATA SERVER ASLI di atas (jangan ngarang). "
        "Kamu juga punya ingatan chat sebelumnya, jadi nyambungin konteks. "
        "Pakai bahasa Indonesia santai, sopan, dan boleh emoji. "
        "Maksimal 500 kata."
    )
    
    response = await execute_task("roleplay", full_prompt, system)
    _add_mem(ch_id, "assistant", response)
    return response
# ══════════════════════════════════════════════════════════════


intents = discord.Intents.default()
intents.message_content = True
intents.members = True

bot = commands.Bot(command_prefix="!", intents=intents)

@bot.event
async def on_ready():
    print(f"✅ Bot {bot.user} udah online!")
    await bot.change_presence(activity=discord.Activity(type=discord.ActivityType.playing, name="🤖 127 Model AI Active"))

@bot.event
async def on_message(message):
    if message.author.bot: return

    # --- FITUR VISION-TO-SERVER ---
    if message.attachments and "buatkan server" in message.content.lower():
        await message.reply("🧠 **AI Vision sedang membaca screenshot server...** Mohon tunggu (proses bisa 15-30 detik).")
        
        attachment = message.attachments[0]
        if not attachment.content_type.startswith("image/"):
            return await message.reply("❌ File harus berupa gambar (JPG/PNG).")

        image_bytes = await attachment.read()
        
        prompt = """
        Analyze this Discord server screenshot. Extract all categories, channels, and roles.
        Output ONLY a valid JSON object like this:
        {"categories": [{"name": "CATEGORY", "channels": [{"name": "channel-name", "type": "text"}]}], "roles": ["Role1", "Role2"]}
        Do not add any explanation.
        """
        
        # Panggil AI (Divisi Vision)
        result = await execute_task("vision", prompt, "You are a strict JSON generator.", image_bytes)
        
        try:
            # Bersihin format markdown dari AI
            clean_json = result.replace("```json", "").replace("```", "").strip()
            data = json.loads(clean_json)
            
            embed = discord.Embed(title="🏗️ Rencana Pembangunan Server", color=discord.Color.gold())
            cat_list = ""
            for cat in data.get("categories", []):
                ch_names = ", ".join([f"#{c['name']}" for c in cat.get("channels", [])])
                cat_list += f"**{cat['name']}**: {ch_names}\n"
            
            embed.add_field(name="Kategori & Channel", value=cat_list[:1000] or "Tidak ada", inline=False)
            embed.add_field(name="Role", value=", ".join(data.get("roles", [])) or "Tidak ada", inline=False)
            embed.set_footer(text="Ketik 'YA' untuk membangun, atau 'TIDAK' untuk batal.")
            
            await message.reply(embed=embed)
            
            # Simpan data di memori bot
            bot.temp_server_data = getattr(bot, 'temp_server_data', {})
            bot.temp_server_data[message.author.id] = data
            
        except Exception as e:
            await message.reply(f"❌ Gagal parse JSON dari AI. Error: {e}\n\nRespons AI:\n{result[:500]}")

    # --- KONFIRMASI BANGUN SERVER ---
    elif message.content.lower() == "ya" and getattr(bot, 'temp_server_data', {}).get(message.author.id):
        data = bot.temp_server_data.pop(message.author.id)
        await message.reply("⏳ **Mulai membangun server...**")
        
        # 1. Bikin Role
        for role_name in data.get("roles", []):
            if not discord.utils.get(message.guild.roles, name=role_name):
                await message.guild.create_role(name=role_name)
                
        # 2. Bikin Kategori & Channel
        for cat in data.get("categories", []):
            category = await message.guild.create_category(cat['name'])
            for ch in cat.get('channels', []):
                try:
                    if ch.get('type') == 'voice':
                        await message.guild.create_voice_channel(ch['name'], category=category)
                    else:
                        await message.guild.create_text_channel(ch['name'], category=category)
                except:
                    pass
                    
        await message.reply("✅ **Server berhasil dibangun sesuai gambar!**")

    # --- COMMAND AI CHAT BIASA ---
    elif message.content.startswith("!ai "):
        prompt = message.content[4:]
        msg = await message.reply("🧠 **AI sedang berpikir...**")
        
        # Panggil AI (Divisi Fast Chat / Roleplay)
        response = await execute_task("fast_chat", prompt)
        await msg.edit(content=response[:2000])


    # --- FITUR MENTION CHAT (SUPER PINTAR 1000%) ---
    elif bot.user.mentioned_in(message) and not message.mention_everyone:
        prompt = message.content.replace(f'<@{bot.user.id}>', '').replace(f'<@!{bot.user.id}>', '').strip()
        
        if prompt:
            async with message.channel.typing():
                action_result = await smart_action(message, prompt)
                if action_result:
                    await message.reply(action_result)
                else:
                    response = await smart_chat(message, prompt)
                    await message.reply(response[:2000])
    
    await bot.process_commands(message)

keep_alive()

TOKEN = os.getenv("DISCORD_TOKEN")
if TOKEN:
    bot.run(TOKEN)
else:
    print("❌ Token Discord gak ketemu di .env!")
