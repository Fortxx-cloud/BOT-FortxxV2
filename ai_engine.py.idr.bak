from dotenv import load_dotenv

load_dotenv()

# === 1. PERMANENT MEMORY (SQLITE) ===
DB_FILE = "memory.db"
def init_db():
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute("""CREATE TABLE IF NOT EXISTS chat_history 
                 (id INTEGER PRIMARY KEY, channel_id TEXT, user_name TEXT, role TEXT, content TEXT, timestamp DATETIME DEFAULT CURRENT_TIMESTAMP)""")
    conn.commit()
    conn.close()

def save_chat(channel_id, user_name, role, content):
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute("INSERT INTO chat_history (channel_id, user_name, role, content) VALUES (?, ?, ?, ?)", 
              (str(channel_id), user_name, role, content))
    conn.commit()
    conn.close()

def get_chat_history(channel_id, limit=10):
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute("SELECT user_name, role, content FROM chat_history WHERE channel_id = ? ORDER BY id DESC LIMIT ?", 
              (str(channel_id), limit))
    rows = c.fetchall()
    conn.close()
    return rows[::-1] # Balikin urutannya (dari lama ke baru)

init_db()

# === 2. LIVE SEARCH (EXA AI) ===

# === MULTI-SEARCH FALLBACK (EXA -> SERPER -> LANGSEARCH -> SERPAPI) ===

# === MULTI-SEARCH FALLBACK (TAVILY -> EXA -> SERPER -> LANGSEARCH -> SERPAPI) ===
async def search_internet(query):
    nl = chr(10)
    
    # 1. COBA TAVILY (KEYLESS - TANPA API KEY)
    try:
        async with aiohttp.ClientSession() as session:
            headers = {
                "Content-Type": "application/json",
                "X-Tavily-Access-Mode": "keyless"
            }
            payload = {"query": query, "max_results": 3}
            async with session.post("https://api.tavily.com/search", headers=headers, json=payload, timeout=15) as r:
                if r.status == 200:
                    data = await r.json()
                    res = data.get("results", [])
                    if res:
                        txt = "🌐 **Hasil Pencarian (Tavily):**" + nl
                        for i in res:
                            txt += "- **" + str(i.get("title")) + "**" + nl
                            txt += "  " + str(i.get("url")) + nl
                            txt += "  " + str(i.get("content"))[:200] + "..." + nl + nl
                        return txt
                elif r.status in [429, 402, 403]:
                    print("⚠️ [SEARCH] Tavily limit. Pindah ke Exa...")
    except Exception as e:
        print(f"⚠️ [SEARCH] Tavily Error: {e}")
        pass


    # 1.5 COBA WEBLESS (KEYLESS - DUCKDUCKGO, MOJEEk, BING)
    try:
        results = await webless_search(query, limit=3)
        if results:
            txt = "🌐 **Hasil Pencarian (Webless):**" + nl
            for i in results:
                title = str(getattr(i, 'title', 'No Title'))
                url = str(getattr(i, 'url', 'No URL'))
                snippet = str(getattr(i, 'snippet', ''))
                txt += "- **" + title + "**" + nl
                txt += "  " + url + nl
                if snippet:
                    txt += "  " + snippet[:150] + "..." + nl
                txt += nl
            return txt
    except Exception as e:
        print(f"⚠️ [SEARCH] Webless Error: {e}")

    # 2. COBA EXA AI
    exa_key = os.getenv("EXA_API_KEY")
    if exa_key:
        try:
            async with aiohttp.ClientSession() as session:
                async with session.post("https://api.exa.ai/search", 
                                        headers={"x-api-key": exa_key, "Content-Type": "application/json"},
                                        json={"query": query, "numResults": 3}, timeout=10) as r:
                    if r.status == 200:
                        data = await r.json()
                        res = data.get("results", [])
                        if res:
                            txt = "🌐 **Hasil Pencarian (Exa):**" + nl
                            for i in res: 
                                txt += "- **" + str(i.get("title")) + "**" + nl + "  " + str(i.get("url")) + nl + "  " + str(i.get("text"))[:150] + "..." + nl + nl
                            return txt
                    elif r.status in [429, 402, 403]:
                        print("⚠️ [SEARCH] Exa limit. Pindah ke Serper...")
        except: pass

    # 3. COBA SERPER (GOOGLE)
    serper_key = os.getenv("SERPER_API_KEY")
    if serper_key:
        try:
            async with aiohttp.ClientSession() as session:
                async with session.post("https://google.serper.dev/search", 
                                        headers={"X-API-KEY": serper_key, "Content-Type": "application/json"},
                                        json={"q": query, "num": 3}, timeout=10) as r:
                    if r.status == 200:
                        data = await r.json()
                        res = data.get("organic", [])
                        if res:
                            txt = "🌐 **Hasil Pencarian (Google/Serper):**" + nl
                            for i in res: 
                                txt += "- **" + str(i.get("title")) + "**" + nl + "  " + str(i.get("link")) + nl + "  " + str(i.get("snippet"))[:150] + "..." + nl + nl
                            return txt
                    elif r.status in [429, 402, 403]:
                        print("⚠️ [SEARCH] Serper limit. Pindah ke LangSearch...")
        except: pass

    # 4. COBA LANGSEARCH
    lang_key = os.getenv("LANGSEARCH_API_KEY")
    if lang_key:
        try:
            async with aiohttp.ClientSession() as session:
                async with session.post("https://api.langsearch.com/v1/web-search", 
                                        headers={"Authorization": "Bearer " + str(lang_key), "Content-Type": "application/json"},
                                        json={"query": query, "count": 3}, timeout=10) as r:
                    if r.status == 200:
                        data = await r.json()
                        pages = data.get("data", {}).get("webPages", {}).get("value", [])
                        if pages:
                            txt = "🌐 **Hasil Pencarian (LangSearch):**" + nl
                            for i in pages: 
                                txt += "- **" + str(i.get("name")) + "**" + nl + "  " + str(i.get("url")) + nl + "  " + str(i.get("snippet"))[:150] + "..." + nl + nl
                            return txt
        except: pass
        
    # 5. COBA SERPAPI
    serpapi_key = os.getenv("SERPAPI_KEY")
    if serpapi_key:
        try:
            async with aiohttp.ClientSession() as session:
                url = "https://serpapi.com/search?api_key=" + str(serpapi_key) + "&q=" + query + "&engine=google"
                async with session.get(url, timeout=10) as r:
                    if r.status == 200:
                        data = await r.json()
                        res = data.get("organic_results", [])
                        if res:
                            txt = "🌐 **Hasil Pencarian (SerpApi):**" + nl
                            for i in res: 
                                txt += "- **" + str(i.get("title")) + "**" + nl + "  " + str(i.get("link")) + nl + "  " + str(i.get("snippet"))[:150] + "..." + nl + nl
                            return txt
        except: pass

    return "❌ Semua API Search (Tavily, Exa, Serper, LangSearch, SerpApi) sedang limit/error."



