# ══════════════════════════════════════════════════════════════
# 📄 WEB READER + SUMMARIZER (Scrape URL & Rangkum)
# ══════════════════════════════════════════════════════════════

async def scrape_url(url):
    """Ambil isi website pakai 3 lapis fallback."""
    nl = chr(10)
    
    # LAPIS 1: FIRECRAWL (KEYLESS)
    try:
        async with aiohttp.ClientSession() as session:
            headers = {"Content-Type": "application/json"}
            payload = {"url": url, "formats": ["markdown"]}
            async with session.post("https://api.firecrawl.dev/v1/scrape", headers=headers, json=payload, timeout=25) as r:
                if r.status == 200:
                    data = await r.json()
                    md = data.get("data", {}).get("markdown", "")
                    title = data.get("data", {}).get("metadata", {}).get("title", url)
                    if md and len(md) > 100:
                        return {"title": title, "content": md, "url": url, "source": "Firecrawl"}
                elif r.status in [429, 402, 403]:
                    print("⚠️ [SCRAPE] Firecrawl limit. Pindah ke Jina...")
    except Exception as e:
        print(f"⚠️ [SCRAPE] Firecrawl Error: {e}")

    # LAPIS 2: JINA READER (KEYLESS)
    try:
        async with aiohttp.ClientSession() as session:
            jina_url = "https://r.jina.ai/" + url
            headers = {"User-Agent": "Mozilla/5.0"}
            # Kalo punya API key Jina, boleh dipake
            jina_key = os.getenv("JINA_API_KEY")
            if jina_key:
                headers["Authorization"] = "Bearer " + jina_key
            async with session.get(jina_url, headers=headers, timeout=25) as r:
                if r.status == 200:
                    text = await r.text()
                    if text and len(text) > 100:
                        # Ambil judul dari baris awal markdown
                        title = url
                        for line in text.split(nl)[:5]:
                            if line.startswith("Title:"):
                                title = line.replace("Title:", "").strip()
                                break
                        return {"title": title, "content": text, "url": url, "source": "Jina Reader"}
                elif r.status in [429, 402, 403]:
                    print("⚠️ [SCRAPE] Jina limit. Pindah ke BS4...")
    except Exception as e:
        print(f"⚠️ [SCRAPE] Jina Error: {e}")

    # LAPIS 3: BEAUTIFULSOUP (PARSING MANUAL)
    try:
        from bs4 import BeautifulSoup
        async with aiohttp.ClientSession() as session:
            headers = {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"}
            async with session.get(url, headers=headers, timeout=20) as r:
                if r.status == 200:
                    html = await r.text()
                    soup = BeautifulSoup(html, "html.parser")
                    # Buang script, style, nav, footer
                    for tag in soup(["script", "style", "nav", "footer", "header", "aside"]):
                        tag.decompose()
                    title = soup.title.string.strip() if soup.title else url
                    # Ambil teks dari body
                    paragraphs = soup.find_all(["p", "h1", "h2", "h3", "li"])
                    content = nl.join(p.get_text().strip() for p in paragraphs if p.get_text().strip())
                    if content and len(content) > 100:
                        return {"title": title, "content": content[:8000], "url": url, "source": "BeautifulSoup"}
    except Exception as e:
        print(f"⚠️ [SCRAPE] BS4 Error: {e}")

    return None

async def summarize_url(url, channel_id=None):
    """Scrape URL lalu rangkum pakai AI."""
    data = await scrape_url(url)
    if not data:
        return "❌ Gagal buka website. Mungkin diproteksi Cloudflare atau butuh login."

    # Potong content biar gak over token (max 6000 karakter)
    content = data["content"][:6000]

    system = "Kamu adalah perangkum web profesional. Rangkum isi web dalam bahasa Indonesia, poin-poin penting, dan sertakan insight. Jangan ngarang di luar isi web."
    prompt = "URL: " + data["url"] + chr(10) + "Judul: " + data["title"] + chr(10) + chr(10) + "Isi Web:" + chr(10) + content

    summary = await execute_task("architect", prompt, system, channel_id=channel_id)

    result = (
        "📄 **Rangkuman Web**" + chr(10) +
        "━━━━━━━━━━━━━━━━━━━━" + chr(10) +
        "🌐 **Judul:** " + data["title"] + chr(10) +
        "🔗 **URL:** " + data["url"] + chr(10) +
        "📡 **Sumber Scrape:** " + data["source"] + chr(10) +
        "━━━━━━━━━━━━━━━━━━━━" + chr(10) + chr(10) +
        summary
    )
    return result
# ══════════════════════════════════════════════════════════════



# ══════════════════════════════════════════════════════════════
# 🔍 DEEP RESEARCH (Search -> Scrape -> Summarize)
# ══════════════════════════════════════════════════════════════

async def expand_query(query):
    """AI rewrite query biar lebih spesifik & efektif."""
    import datetime
    current_year = datetime.datetime.now().year
    system = f"Kamu adalah query optimizer Google. Ubah pertanyaan user jadi query pencarian yang SPESIFIK dan EFEKTIF. Tambahkan kata kunci penting (nama produk lengkap, toko, dll) dan tahun berjalan yaitu {current_year} jika relevan. Balas HANYA dengan query (tanpa penjelasan, tanpa tanda kutip). Maksimal 10 kata."
    try:
        res = await execute_task("fast_chat", query, system)
        expanded = res.strip().strip('"').strip("'").split(chr(10))[0][:120]
        if expanded and len(expanded) > 3:
            print(f"🔍 [EXPAND] '{query}' -> '{expanded}'")
            return expanded
    except Exception as e:
        print(f"⚠️ [EXPAND] gagal: {e}")
    return query

async def search_multi(query, limit=10):
    """Search multi-engine. Prioritas: LangSearch -> Serper -> DDG -> Webless -> Tavily -> Exa."""
    all_results = []
    seen_urls = set()

    # 0. Expand query pakai AI
    expanded = await expand_query(query)

    # === LAPIS 1: LANGSEARCH (Paling longgar kuota + tercepat) ===
    lang_key = os.getenv("LANGSEARCH_API_KEY")
    if lang_key:
        try:
            async with aiohttp.ClientSession() as session:
                headers = {"Authorization": f"Bearer {lang_key}", "Content-Type": "application/json"}
                payload = {"query": expanded, "count": limit}
                async with session.post("https://api.langsearch.com/v1/web-search", headers=headers, json=payload, timeout=15) as r:
                    if r.status == 200:
                        data = await r.json()
                        pages = data.get("data", {}).get("webPages", {}).get("value", [])
                        for i in pages:
                            url = i.get("url")
                            if url and url not in seen_urls:
                                seen_urls.add(url)
                                all_results.append({
                                    "url": url,
                                    "title": i.get("name", ""),
                                    "snippet": str(i.get("snippet", ""))[:200],
                                    "source": "LangSearch"
                                })
                                if len(all_results) >= limit: break
                        print(f"✅ [SEARCH-1] LangSearch: {len(all_results)} hasil")
                    elif r.status in [429, 402, 403]:
                        print(f"⚠️ [SEARCH-1] LangSearch limit (HTTP {r.status}), pindah ke Serper...")
                    else:
                        print(f"⚠️ [SEARCH-1] LangSearch HTTP {r.status}")
        except Exception as e:
            print(f"⚠️ [SEARCH-1] LangSearch: {type(e).__name__}")

    # === LAPIS 2: SERPER (Google) ===
    if len(all_results) < limit:
        serper_key = os.getenv("SERPER_API_KEY")
        if serper_key:
            try:
                async with aiohttp.ClientSession() as session:
                    headers = {"X-API-KEY": serper_key, "Content-Type": "application/json"}
                    payload = {"q": expanded, "num": limit - len(all_results), "gl": "id", "hl": "id"}
                    async with session.post("https://google.serper.dev/search", headers=headers, json=payload, timeout=15) as r:
                        if r.status == 200:
                            data = await r.json()
                            added = 0
                            for i in data.get("organic", []):
                                url = i.get("link")
                                if url and url not in seen_urls:
                                    seen_urls.add(url)
                                    all_results.append({"url": url, "title": i.get("title", ""), "snippet": i.get("snippet", "")[:200], "source": "Google"})
                                    added += 1
                                    if len(all_results) >= limit: break
                            print(f"✅ [SEARCH-2] Serper/Google: +{added} hasil (total {len(all_results)})")
                        elif r.status in [429, 402, 403]:
                            print(f"⚠️ [SEARCH-2] Serper limit (HTTP {r.status}), pindah ke DDG...")
                        else:
                            print(f"⚠️ [SEARCH-2] Serper HTTP {r.status}")
            except Exception as e:
                print(f"⚠️ [SEARCH-2] Serper: {type(e).__name__}")

    # === LAPIS 3: DDG HTML ===
    if len(all_results) < limit:
        try:
            from bs4 import BeautifulSoup
            import urllib.parse
            async with aiohttp.ClientSession() as session:
                headers = {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"}
                async with session.get("https://html.duckduckgo.com/html/", params={"q": expanded}, headers=headers, timeout=15) as r:
                    if r.status == 200:
                        html = await r.text()
                        soup = BeautifulSoup(html, "html.parser")
                        added = 0
                        for a in soup.select("a.result__a"):
                            href = a.get("href", "")
                            if "uddg=" in href:
                                try: href = urllib.parse.unquote(href.split("uddg=")[1].split("&")[0])
                                except: pass
                            if href and href not in seen_urls:
                                seen_urls.add(href)
                                title = a.get_text().strip()
                                snippet = ""
                                parent = a.find_parent("div", class_="result")
                                if parent:
                                    sn = parent.find("a", class_="result__snippet")
                                    if sn: snippet = sn.get_text().strip()[:200]
                                all_results.append({"url": href, "title": title, "snippet": snippet, "source": "DDG"})
                                added += 1
                                if len(all_results) >= limit: break
                        print(f"✅ [SEARCH-3] DDG: +{added} hasil (total {len(all_results)})")
                    else:
                        print(f"⚠️ [SEARCH-3] DDG HTTP {r.status}")
        except Exception as e:
            print(f"⚠️ [SEARCH-3] DDG: {type(e).__name__}")

    # === LAPIS 4: WEBLESS ===
    if len(all_results) < 3:
        try:
            wl = await webless_search(expanded, limit=limit - len(all_results))
            added = 0
            for i in wl:
                url = str(getattr(i, 'url', ''))
                if url and url not in seen_urls:
                    seen_urls.add(url)
                    all_results.append({"url": url, "title": str(getattr(i, 'title', '')), "snippet": str(getattr(i, 'snippet', ''))[:200], "source": "Webless"})
                    added += 1
                    if len(all_results) >= limit: break
            print(f"✅ [SEARCH-4] Webless: +{added} hasil (total {len(all_results)})")
        except Exception as e:
            print(f"⚠️ [SEARCH-4] Webless: {type(e).__name__}")

    # === LAPIS 5: TAVILY ===
    if len(all_results) < limit:
        try:
            async with aiohttp.ClientSession() as session:
                headers = {"Content-Type": "application/json", "X-Tavily-Access-Mode": "keyless"}
                payload = {"query": expanded, "max_results": limit - len(all_results)}
                async with session.post("https://api.tavily.com/search", headers=headers, json=payload, timeout=15) as r:
                    if r.status == 200:
                        data = await r.json()
                        added = 0
                        for i in data.get("results", []):
                            url = i.get("url")
                            if url and url not in seen_urls:
                                seen_urls.add(url)
                                all_results.append({"url": url, "title": i.get("title", ""), "snippet": str(i.get("content", ""))[:200], "source": "Tavily"})
                                added += 1
                                if len(all_results) >= limit: break
                        print(f"✅ [SEARCH-5] Tavily: +{added} hasil (total {len(all_results)})")
        except Exception as e:
            print(f"⚠️ [SEARCH-5] Tavily: {type(e).__name__}")

    # === LAPIS 6: EXA ===
    if len(all_results) < 3:
        exa_key = os.getenv("EXA_API_KEY")
        if exa_key:
            try:
                async with aiohttp.ClientSession() as session:
                    headers = {"x-api-key": exa_key, "Content-Type": "application/json"}
                    payload = {"query": expanded, "numResults": limit - len(all_results)}
                    async with session.post("https://api.exa.ai/search", headers=headers, json=payload, timeout=15) as r:
                        if r.status == 200:
                            data = await r.json()
                            added = 0
                            for i in data.get("results", []):
                                url = i.get("url")
                                if url and url not in seen_urls:
                                    seen_urls.add(url)
                                    all_results.append({"url": url, "title": i.get("title", ""), "snippet": str(i.get("text", ""))[:200], "source": "Exa"})
                                    added += 1
                                    if len(all_results) >= limit: break
                            print(f"✅ [SEARCH-6] Exa: +{added} hasil (total {len(all_results)})")
            except Exception as e:
                print(f"⚠️ [SEARCH-6] Exa: {type(e).__name__}")

    return all_results

# Alias buat backward compat
async def search_raw(query, limit=3):
    return await search_multi(query, limit=limit)

async def research_web(query, channel_id=None, max_urls=5):
    """Deep Research Multi-Source: cari, scrape max 5 web paralel, rangkum semua."""
    nl = chr(10)

    print(f"🔍 [RESEARCH] Searching: {query}")
    results = await search_multi(query, limit=max_urls)

    if not results:
        return "❌ Gak nemu hasil pencarian buat: " + query

    urls_to_scrape = results[:max_urls]
    print(f"📄 [RESEARCH] Scraping {len(urls_to_scrape)} URL paralel...")

    sem = asyncio.Semaphore(3)
    async def _scrape(u):
        async with sem:
            return await scrape_url(u)

    tasks = [_scrape(r["url"]) for r in urls_to_scrape]
    scraped = await asyncio.gather(*tasks, return_exceptions=True)

    ok = []
    for s in scraped:
        if s and not isinstance(s, Exception):
            ok.append(s)

    if not ok:
        snippets = nl.join(f"- {r['title']}: {r['snippet']}" for r in results)
        return "⚠️ Gagal buka semua web. Rangkuman dari snippet:" + nl + nl + snippets

    # Gabung konten (max 2000 char/sumber biar gak overload)
    combined = ""
    sources_list = ""
    for i, s in enumerate(ok, 1):
        content = s["content"][:2000]
        combined += nl + f"=== SUMBER {i}: {s['title']} ===" + nl
        combined += f"URL: {s['url']}" + nl
        combined += content + nl
        sources_list += f"{i}. [{s['title']}]({s['url']}) *(via {s['source']})*" + nl

    system = (
        "Kamu adalah peneliti profesional. Jawab pertanyaan user berdasarkan SEMUA sumber web yang diberikan. "
        "Sintesis informasi dari berbagai sumber. Sebutkan fakta, angka, dan detail penting. "
        "Bahasa Indonesia, poin-poin jelas. Jangan ngarang di luar isi web. "
        "Kalau sumber tidak relevan dengan pertanyaan, bilang dengan jujur."
    )
    prompt = f"Pertanyaan user: {query}{nl}{nl}Sumber-sumber web:{combined}"

    summary = await execute_task("architect", prompt, system, channel_id=channel_id)

    result = (
        "🔍 **Deep Research Multi-Source: " + query + "**" + nl +
        "━━━━━━━━━━━━━━━━━━━━" + nl +
        f"📚 **{len(ok)} Sumber Dibuka:**" + nl + sources_list +
        "━━━━━━━━━━━━━━━━━━━━" + nl + nl +
        summary
    )
    return result


async def decide_action(prompt):
    """Pakai AI buat mutusin aksi berdasarkan prompt user."""
    system = """Kamu adalah Router AI. Tugasmu menentukan aksi berdasarkan prompt user.
    Balas HANYA dengan JSON valid, TANPA markdown, TANPA penjelasan.
    
    Aturan:
    - Jika user tanya info terbaru/berita/harga/jadwal/data terkini ATAU minta cari di internet, balas:
      {"action": "search", "query": "kata kunci pencarian spesifik"}
    - Jika user kasih URL dan minta dibuka/dirangkum/dijelaskan, balas:
      {"action": "scrape", "url": "https://..."}
    - Jika user ngobrol biasa, nanya konsep umum, atau minta bikin sesuatu, balas:
      {"action": "chat"}
    """
    try:
        res = await execute_task("fast_chat", prompt, system)
        clean = res.replace("```json", "").replace("```", "").strip()
        start = clean.find("{")
        end = clean.rfind("}") + 1
        if start == -1 or end == 0: return {"action": "chat"}
        clean = clean[start:end]
        import json
        data = json.loads(clean)
        if data.get("action") not in ["search", "scrape", "chat"]: return {"action": "chat"}
        return data
    except Exception as e:
        print(f"⚠️ [ROUTER] Fallback ke chat. Error: {e}")
        return {"action": "chat"}


# === 3. MAP PROVIDER & TASKS ===
PROVIDERS = {
    "chatanywhere": {"url": "https://api.chatanywhere.tech/v1/chat/completions", "key": os.getenv("CHATANYWHERE_API_KEY"), "type": "openai"},
    "cloudflare": {"url": "https://api.cloudflare.com/client/v4/accounts/{acc}/ai/run/", "key": os.getenv("CF_API_TOKEN"), "acc": os.getenv("CF_ACCOUNT_ID"), "type": "cloudflare"},
    "gemini": {"url": "https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={key}", "key": os.getenv("GEMINI_API_KEY"), "type": "gemini"},
    "mistral": {"url": "https://api.mistral.ai/v1/chat/completions", "key": os.getenv("MISTRAL_API_KEY"), "type": "openai"},
    "onomeo": {"url": "https://onomeo.com/v1/chat/completions", "key": os.getenv("ONOMEO_API_KEY"), "type": "openai"},
    "openrouter": {"url": "https://openrouter.ai/api/v1/chat/completions", "key": os.getenv("OPENROUTER_API_KEY"), "type": "openai"},
    "groq": {"url": "https://api.groq.com/openai/v1/chat/completions", "key": os.getenv("GROQ_API_KEY"), "type": "openai"},
    "cohere": {"url": "https://api.cohere.com/v2/chat", "key": os.getenv("COHERE_API_KEY"), "type": "cohere"},
    "pollinations": {"url": "https://text.pollinations.ai/openai", "key": None, "type": "openai"},
    "llm7": {"url": "https://api.llm7.io/v1/chat/completions", "key": os.getenv("LLM7_TOKENS"), "type": "openai"}
}

TASKS = {
    "vision": [("cohere", "command-a-vision-07-2025"), ("openrouter", "nvidia/nemotron-3.5-super-vl:free"), ("chatanywhere", "gpt-4o")],
    "architect": [("cohere", "command-a-reasoning-08-2025"), ("groq", "qwen/qwen3.8-27b"), ("mistral", "mistral-code-latest"), ("cloudflare", "@cf/qwen/qwq-32b")],
    "fast_chat": [("groq", "qwen/qwen3.8-27b"), ("groq", "allam-2-7b"), ("pollinations", "openai-fast"), ("cloudflare", "@cf/meta/llama-3.2-3b-instruct"), ("cohere", "command-a-reasoning-08-2025")],
    "roleplay": [("groq", "qwen/qwen3.8-27b"), ("mistral", "ministral-14b-latest"), ("cloudflare", "@cf/meta/llama-3.3-70b-instruct-fp8-fast")],
    "emergency": [("chatanywhere", "gpt-6.1-sol"), ("chatanywhere", "gpt-4o"), ("gemini", "gemini-3.6-flash"), ("mistral", "codestral-latest")]
}

COOLDOWNS = {}
COOLDOWN_DURATION = 300

# === 4. CORE API CALLER ===
async def _call_api(session, provider_name, model, messages, image_b64=None):
    cfg = PROVIDERS.get(provider_name)
    if not cfg: return None, "SKIP"

    headers = {"Content-Type": "application/json"}
    if cfg["key"]: headers["Authorization"] = f"Bearer {cfg['key']}"

    if image_b64:
        content = [{"type": "text", "text": messages[-1]["content"]}]
        content.append({"type": "image_url", "image_url": {"url": f"data:image/jpeg;base64,{image_b64}"}})
        messages[-1]["content"] = content

    if cfg["type"] == "gemini":
        url = cfg["url"].format(model=model, key=cfg["key"])
        payload = {"contents": [{"parts": [{"text": m["content"] if isinstance(m["content"], str) else m["content"][0]["text"]}]} for m in messages]}
        if image_b64: payload["contents"][-1]["parts"].append({"inline_data": {"mime_type": "image/jpeg", "data": image_b64}})
    elif cfg["type"] == "cloudflare":
        url = f"{cfg['url'].format(acc=cfg['acc'])}{model}"
        payload = {"messages": messages}
    elif cfg["type"] == "cohere":
        url = cfg["url"]
        payload = {"model": model, "messages": messages}
    else:
        url = cfg["url"]
        payload = {"model": model, "messages": messages, "max_tokens": 1500}

    try:
        async with session.post(url, headers=headers, json=payload, timeout=10) as r:
            if r.status == 200:
                data = await r.json()
                if cfg["type"] == "gemini": return data['candidates'][0]['content']['parts'][0]['text'], "OK"
                elif cfg["type"] == "cloudflare": return data['result']['response'], "OK"
                else: return data['choices'][0]['message']['content'], "OK"
            elif r.status in [429, 402, 403]: return None, "LIMIT"
            else: return None, "ERROR"
    except Exception: return None, "ERROR"

# === 5. EXECUTE TASK (DENGAN MEMORY) ===
async def execute_task(task_type, prompt, system_prompt="Kamu adalah asisten AI yang cerdas.", image_bytes=None, channel_id=None):
    messages = [{"role": "system", "content": system_prompt}]
    
    # Tarik ingatan dari database kalau ada channel_id
    if channel_id:
        history = get_chat_history(channel_id, 6)
        for user, role, content in history:
            messages.append({"role": role, "content": content})
            
    messages.append({"role": "user", "content": prompt})
    image_b64 = base64.b64encode(image_bytes).decode('utf-8') if image_bytes else None
    
    models_to_try = TASKS.get(task_type, []) + TASKS["emergency"]
    
    async with aiohttp.ClientSession() as session:
        for provider, model in models_to_try:
            model_key = (provider, model)
            if model_key in COOLDOWNS and time.time() < COOLDOWNS[model_key]:
                continue
                
            print(f"🚀 [ROUTER] Mencoba {provider} -> {model}...")
            res, status = await _call_api(session, provider, model, messages, image_b64)
            
            if status == "OK" and res:
                if channel_id:
                    save_chat(channel_id, "User", "user", prompt)
                    save_chat(channel_id, "Bot", "assistant", res)
                return res
            elif status == "LIMIT":
                COOLDOWNS[model_key] = time.time() + COOLDOWN_DURATION
                print(f"⚠️ [LIMIT] {provider} -> {model} penjara {COOLDOWN_DURATION}s!")
                
    return "❌ Maaf Bang, semua model AI sedang sibuk."

# === 6. MULTI-STEP AGENT ===
async def agent_action(guild, user_prompt, channel_id=None):
    """Minta AI ngerencanain aksi dalam bentuk JSON List"""
    system = """Kamu adalah Agen Server Discord. Jika user meminta perubahan server, 
    balas HANYA dengan JSON array berisi aksi. Contoh:
    [{"action": "create_category", "name": "Toko"}, {"action": "create_channel", "name": "info", "category": "Toko"}]
    Aksi yang tersedia: create_category, create_channel, create_role.
    Jika tidak ada aksi server, balas dengan "CHAT: [jawaban biasa]".
    """
    res = await execute_task("architect", user_prompt, system, channel_id=channel_id)
    
    if not res or not res.strip().startswith("["): return None
    
    try:
        actions = json.loads(res)
        for act in actions:
            if act["action"] == "create_category":
                await guild.create_category(act["name"])
            elif act["action"] == "create_channel":
                cat = discord.utils.get(guild.categories, name=act.get("category"))
                await guild.create_text_channel(act["name"], category=cat)
            elif act["action"] == "create_role":
                await guild.create_role(name=act["name"])
        return f"✅ Berhasil mengeksekusi {len(actions)} aksi sekaligus!"
    except Exception as e:
        return f"❌ Gagal eksekusi agen: {e}"
