async def _call_api(session, provider_name, model, messages, image_b64=None):
    cfg = PROVIDERS.get(provider_name)
    if not cfg: return None

    headers = {"Content-Type": "application/json"}
    if cfg["key"]: headers["Authorization"] = f"Bearer {cfg['key']}"

    # --- FORMAT PAYLOAD ---
    if image_b64:
        # Format Vision (OpenAI style)
        content = [{"type": "text", "text": messages[-1]["content"]}]
        content.append({"type": "image_url", "image_url": {"url": f"data:image/jpeg;base64,{image_b64}"}})
        messages[-1]["content"] = content

    if cfg["type"] == "gemini":
        # Gemini format
        url = cfg["url"].format(model=model, key=cfg["key"])
        payload = {"contents": [{"parts": [{"text": m["content"] if isinstance(m["content"], str) else m["content"][0]["text"]}]} for m in messages]}
        if image_b64:
            payload["contents"][-1]["parts"].append({"inline_data": {"mime_type": "image/jpeg", "data": image_b64}})
    elif cfg["type"] == "cloudflare":
        url = f"{cfg['url'].format(acc=cfg['acc'])}{model}"
        payload = {"messages": messages}
    elif cfg["type"] == "cohere":
        url = cfg["url"]
        payload = {"model": model, "messages": messages}
    else:
        url = cfg["url"]
        payload = {"model": model, "messages": messages, "max_tokens": 1000}

    try:
        async with session.post(url, headers=headers, json=payload, timeout=30) as r:
            if r.status == 200:
                data = await r.json()
                if cfg["type"] == "gemini":
                    return data['candidates'][0]['content']['parts'][0]['text']
                elif cfg["type"] == "cloudflare":
                    return data['result']['response']
                else:
                    return data['choices'][0]['message']['content']
            else:
                print(f"⚠️ [{provider_name}] {model} gagal (HTTP {r.status}). Coba cadangan...")
                return None
    except Exception as e:
        print(f"❌ [{provider_name}] {model} error: {type(e).__name__}")
        return None

async def execute_task(task_type, prompt, system_prompt="Kamu adalah asisten AI yang cerdas.", image_bytes=None):
    """Fungsi utama buat milih model sesuai tugas dan fallback otomatis."""
    
    messages = [
        {"role": "system", "content": system_prompt},
        {"role": "user", "content": prompt}
    ]
    
    image_b64 = base64.b64encode(image_bytes).decode('utf-8') if image_bytes else None
    
    models_to_try = TASKS.get(task_type, [])
    # Kalau tugasnya gak ada, atau semua model di tugas itu gagal, lempar ke emergency
    models_to_try.extend(TASKS["emergency"])
    
    async with aiohttp.ClientSession() as session:
        for provider, model in models_to_try:
            print(f"🚀 [ROUTER] Mencoba {provider} -> {model}...")
            res = await _call_api(session, provider, model, messages, image_b64)
            if res:
                return res # Berhasil! Langsung balikin jawaban
                
    return "❌ Maaf Bang, semua model AI sedang sibuk/error. Coba lagi nanti."
