import discord
from discord.ext import commands
import os
import json
from dotenv import load_dotenv
from ai_engine import execute_task, agent_action, search_internet, get_weather, get_dictionary, get_news, get_currency, get_ip_info, summarize_url, research_web, decide_action
from keep_alive import keep_alive

load_dotenv()

intents = discord.Intents.default()
intents.message_content = True
intents.members = True


import asyncio

async def send_long(target, text, placeholder=None):
    """Kirim pesan panjang, pecah otomatis biar gak kepotong (Discord 2000 char limit)."""
    MAX = 1900
    text = (text or "").strip()
    if not text:
        return
    if len(text) <= MAX:
        if placeholder:
            try: await placeholder.edit(content=text)
            except: pass
        else:
            try: await target.reply(text)
            except: await target.channel.send(text)
        return
    
    # Pecah per baris biar rapi
    chunks = []
    buf = ""
    for line in text.split(chr(10)):
        if len(buf) + len(line) + 1 > MAX:
            if buf:
                chunks.append(buf)
                buf = ""
            while len(line) > MAX:
                chunks.append(line[:MAX])
                line = line[MAX:]
            buf = line
        else:
            buf = buf + chr(10) + line if buf else line
    if buf:
        chunks.append(buf)
    
    # Hapus placeholder kalau ada
    if placeholder:
        try: await placeholder.delete()
        except: pass
    
    # Kirim tiap chunk berurutan
    for i, chunk in enumerate(chunks):
        if i == 0 and not placeholder:
            try:
                await target.reply(chunk)
            except:
                await target.channel.send(chunk)
        else:
            await target.channel.send(chunk)
        await asyncio.sleep(0.4)  # Anti rate limit


bot = commands.Bot(command_prefix="!", intents=intents)

@bot.event
async def on_ready():
    print(f"✅ Bot {bot.user} udah online!")
    await bot.change_presence(activity=discord.Activity(type=discord.ActivityType.playing, name="🤖 127 AI | Memory + Search"))

@bot.event
async def on_message(message):
    if message.author.bot: return


    # --- FITUR MENTION (SEARCH + AGENT + CHAT + MEMORY) ---
    if bot.user.mentioned_in(message) and not message.mention_everyone:
        prompt = message.content.replace(f'<@{bot.user.id}>', '').replace(f'<@!{bot.user.id}>', '').strip()
        
        if prompt:
            # --- CURRENCY CONVERTER (Direct) ---
            import re as _re
            cur_pair = _re.search(r'(usd|eur|gbp|jpy|sgd|myr|aud|idr)\s*(?:ke|to|jadi|->)\s*(usd|eur|gbp|jpy|sgd|myr|aud|idr)', prompt.lower())
            if cur_pair:
                from_cur = cur_pair.group(1).upper()
                to_cur = cur_pair.group(2).upper()
                async with message.channel.typing():
                    res = await get_currency(from_cur, to_cur)
                    await message.reply(res)
                return

            try:
                # 1. Minta AI Router mutusin aksi
                action_data = await decide_action(prompt)
                action_type = action_data.get("action", "chat")
                print(f"🧠 [ROUTER] Action: {action_type}")

                if action_type == "search":
                    query = action_data.get("query", prompt)
                    msg = await message.reply(f"🔍 **Mencari: {query}...**")
                    res = await research_web(query, channel_id=message.channel.id)
                    await msg.edit(content=res)
                    return
                    
                elif action_type == "scrape":
                    url = action_data.get("url")
                    msg = await message.reply(f"📄 **Membuka & merangkum:** {url}")
                    res = await summarize_url(url, channel_id=message.channel.id)
                    await msg.edit(content=res)
                    return
                    
                else: # chat
                    async with message.channel.typing():
                        # Cek dulu: apakah ini perintah aksi server?
                        action_kws = ["bikin", "buat", "tambah", "create", "hapus", "delete"]
                        server_kws = ["channel", "kanal", "role", "peran", "kategori", "category"]
                        is_action = any(a in prompt.lower() for a in action_kws) and any(s in prompt.lower() for s in server_kws)
                        
                        if is_action:
                            action_res = await agent_action(message.guild, prompt, message.channel.id)
                            if action_res:
                                await send_long(message, action_res)
                                return
                        
                        # Bukan aksi -> chat natural pakai NATURAL_SYSTEM
                        from ai_engine import NATURAL_SYSTEM
                        response = await execute_task("fast_chat", prompt, NATURAL_SYSTEM, channel_id=message.channel.id)
                        await send_long(message, response)
                    return
                    return
            except Exception as e:
                print(f"❌ [MENTION] Error: {e}")
                await message.reply(f"❌ Error: {str(e)[:200]}")
                return

    # --- FITUR VISION-TO-SERVER ---
    elif message.attachments and "buatkan server" in message.content.lower():
        await message.reply("🧠 **AI Vision sedang membaca screenshot...**")
        attachment = message.attachments[0]
        if not attachment.content_type.startswith("image/"):
            return await message.reply("❌ File harus gambar.")
        image_bytes = await attachment.read()
        
        prompt = """
        Analyze this Discord server screenshot. Extract all categories, channels, and roles.
        Output ONLY JSON: {"categories": [{"name": "CATEGORY", "channels": [{"name": "channel-name", "type": "text"}]}], "roles": ["Role1"]}
        """
        result = await execute_task("vision", prompt, "You are a strict JSON generator.", image_bytes, channel_id=message.channel.id)
        
        try:
            clean_json = result.replace("```json", "").replace("```", "").strip()
            data = json.loads(clean_json)
            
            embed = discord.Embed(title="🏗️ Rencana Pembangunan Server", color=discord.Color.gold())
            cat_list = ""
            for cat in data.get("categories", []):
                ch_names = ", ".join([f"#{c['name']}" for c in cat.get("channels", [])])
                cat_list += f"**{cat['name']}**: {ch_names}\n"
            
            embed.add_field(name="Kategori & Channel", value=cat_list[:1000] or "Tidak ada", inline=False)
            embed.add_field(name="Role", value=", ".join(data.get("roles", [])) or "Tidak ada", inline=False)
            embed.set_footer(text="Ketik 'YA' untuk membangun.")
            await message.reply(embed=embed)
            
            bot.temp_server_data = getattr(bot, 'temp_server_data', {})
            bot.temp_server_data[message.author.id] = data
        except Exception as e:
            await message.reply(f"❌ Gagal parse JSON: {e}\nRespons: {result[:300]}")

    elif message.content.lower() == "ya" and getattr(bot, 'temp_server_data', {}).get(message.author.id):
        data = bot.temp_server_data.pop(message.author.id)
        await message.reply("⏳ **Mulai membangun server...**")
        for role_name in data.get("roles", []):
            if not discord.utils.get(message.guild.roles, name=role_name):
                await message.guild.create_role(name=role_name)
        for cat in data.get("categories", []):
            category = await message.guild.create_category(cat['name'])
            for ch in cat.get('channels', []):
                if ch.get('type') == 'voice': await message.guild.create_voice_channel(ch['name'], category=category)
                else: await message.guild.create_text_channel(ch['name'], category=category)
        await message.reply("✅ **Server berhasil dibangun!**")

    await bot.process_commands(message)

keep_alive()
TOKEN = os.getenv("DISCORD_TOKEN")
if TOKEN: bot.run(TOKEN)
